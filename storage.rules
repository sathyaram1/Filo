rules_version = '2';

// Storage rules per l'alpha test.
// Gli allegati dei feedback vivono in /feedback/*.
// - Upload: chiunque, fino a 4 MB, SOLO tipi passivi in allowlist esplicita.
//   ⚠️ NIENTE wildcard `text/.*` o `image/.*`: lasciavano passare content-type
//   attivi (`text/html` con script, `image/svg+xml`). Il gate deterministico
//   lato pipeline (filo-security, L0 fileGate) marca comunque `suspicious_file`
//   i feedback con allegati fuori allowlist: questa regola è la cintura,
//   quello le bretelle.
// - Get: aperto (la dashboard mostra immagini e file via link diretto, e quei
//   link portano già il loro token di download).
// - List: NEGATO (#583). Un elenco è una cosa diversa da un file: chiedendolo,
//   chiunque si portava via il nome di ogni allegato mai caricato e poi il
//   contenuto, senza sapere niente di nessun feedback. Il resto dell'audit ha
//   chiuso la lettura dei documenti, che era l'altra strada per arrivarci: se
//   il bucket resta elencabile, quella chiusura vale la metà. Gli allegati dal
//   25 giugno 2026 sono cifrati, ma i più vecchi no.

service firebase.storage {
  match /b/{bucket}/o {

    match /feedback/{file=**} {
      allow get: if true;
      allow list: if false;
      allow write: if
        request.resource.size < 4 * 1024 * 1024
        && (
          request.resource.contentType.matches('image/(png|jpeg|jpg|gif|webp|bmp)')
          || request.resource.contentType == 'text/plain'
          || request.resource.contentType == 'text/markdown'
          || request.resource.contentType == 'text/csv'
          || request.resource.contentType == 'application/pdf'
          || request.resource.contentType == 'application/json'
          // blob cifrati S1.2 (maybeEncryptBlob) viaggiano come octet-stream
          || request.resource.contentType == 'application/octet-stream'
        );
    }

    // Tutto il resto è chiuso.
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
