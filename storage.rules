rules_version = '2';

// Regole Storage degli ALLEGATI dei feedback.
// Due audit pre-alpha si incontrano qui: #582 (queste regole) e #583 (la
// lettura dei documenti dei feedback). Confine unico, scritto una volta.
//
// Cosa c'era prima, e perché non reggeva. Su `feedback/{file=**}` la lettura
// era `if true` e la scrittura chiedeva solo dimensione e content-type:
// nessun controllo di identità, in nessuna direzione.
// - In Storage `read` comprende `list`: col nome del bucket (che sta nel repo,
//   accanto alla chiave web di Firebase) si ELENCAVA il bucket e si scaricava
//   tutto — cioè gli screenshot dello schermo dei tester, uno dopo l'altro,
//   senza sapere niente di nessun feedback.
// - `write` comprende `update` e `delete`: chi conosceva il nome di un allegato
//   ci scriveva sopra (uno screenshot sostituito dopo che il giudice l'ha
//   visto) o lo cancellava.
// - E un bucket aperto in lettura è hosting gratuito sul dominio dell'owner.
//
// Il confine ora:
// - Upload: chiunque manda un feedback, anche senza login — l'invio anonimo è
//   voluto, e resta — fino a 4 MB, SOLO in creazione, SOLO un blob cifrato
//   dall'app (tipo opaco, estensione fissa, nessun metadato scelto da chi
//   carica: #1518) e SOLO su un nome che non si indovina (sotto, in dettaglio).
//   Il tipo VERO del file lo decide il client prima di cifrare
//   (src/shared/feedbackAttachTypes.js) e lo ricontrolla il gate L0 del server
//   (filo-security, fileGate) sul documento del feedback: qui non c'è più una
//   lista di tipi, perché da #602 nessun caricatore manda byte in chiaro.
// - List: NEGATO (#583). Un elenco è una cosa diversa da un file: chiedendolo,
//   chiunque si portava via il nome di ogni allegato mai caricato e poi il
//   contenuto, senza sapere niente di nessun feedback. Il resto dell'audit ha
//   chiuso la lettura dei documenti, che era l'altra strada per arrivarci: se
//   il bucket resta elencabile, quella chiusura vale la metà. Gli allegati dal
//   25 giugno 2026 sono cifrati, ma i più vecchi no — e fino al #602 non lo
//   erano nemmeno quelli aggiunti ai COMMENTI di un feedback (schermate e log
//   del lavoro), che salivano sempre in chiaro perché la pagina che li carica
//   la cifratura non ce l'aveva caricata. Quelli già nel deposito restano in
//   chiaro: la cura per un allegato vecchio è ruotarne il codice di scarico
//   dalla console, come per gli altri.
// - Get: NEGATO (#583, giro 8). Chi passa da queste regole non scarica niente.
//   L'unica chiave è il download token nel link, che Firebase valuta PRIMA
//   delle regole: `.../o/<path>?alt=media&token=<t>` continua a funzionare,
//   `.../o/<path>?alt=media` senza token no. Provato con l'emulatore ufficiale
//   di Storage: con `get: if false` il link col token risponde 200, il solo
//   indirizzo e un token sbagliato rispondono 403.
//
//   Perché non basta aver chiuso l'elenco. Finché il get era `if true` il token
//   non lo guardava nessuno: bastava l'indirizzo del file, e gli indirizzi degli
//   allegati stavano DENTRO i documenti dei feedback, che fino a questo audit
//   chiunque leggeva con la sola chiave web del repo. Chi li ha raccolti in
//   quei mesi se li tiene. La cura di serie per un link scappato è cambiare il
//   token di quel file dalla console (o ricaricarlo): con il get aperto quella
//   cura non serviva a niente, perché il file si prendeva lo stesso
//   dall'indirizzo. Adesso serve — ed è l'unico modo di togliere davvero dalla
//   circolazione gli screenshot in chiaro anteriori al 25 giugno 2026.
//
//   Chi legge per davvero non passa da qui: la dashboard non mette mai
//   l'indirizzo dentro un <img>, lo manda al main, che scarica col link intero
//   (token compreso) e decifra con la chiave privata. Il server dei giudici e
//   delle routine usa l'Admin SDK, che queste regole le bypassa.
//
//   Conseguenza sull'upload: il link SENZA token adesso è un link morto, quindi
//   un allegato caricato senza che il deposito ne rilasci uno non si deve
//   registrare come riuscito (src/shared/feedback.js → uploadImage rifiuta, e
//   chi invia se lo vede scritto fra gli allegati non caricati).
//
// - Scrittura: SOLO in CREAZIONE, su un nome che ancora non esiste (#582).
//   Niente `update`, niente `delete`: un allegato, una volta scritto, è
//   immutabile. Il `resource == null` è ciò che lo dice, ed è anche ciò che
//   rende la cancellazione impossibile (in una delete `resource` c'è).
//   Conseguenza da tenere presente: cancellare un allegato non è permesso a
//   nessuno, owner compreso, quindi un file caricato per dispetto si toglie
//   solo dalla console del progetto.
// - Il nome deve portare ENTROPIA (un uuid), così non lo si indovina e non lo
//   si riusa: il pattern è quello che genera `SN_FEEDBACK.attachmentPath`
//   (src/shared/feedback.js), e una sentinella negli unit test
//   (tests/unit/storageRulesAllegati.test.mjs) confronta i due e diventa rossa
//   se divergono. Senza, `screenshot.png` era un nome come un altro.
//
// LA CAPACITÀ CHE RESTA, dichiarata. Una strada per leggere un allegato esiste
// ed è una sola: il download token che Storage assegna all'oggetto quando
// viene creato e che finisce nell'URL salvato nel feedback
// (`?alt=media&token=…`). Quei link scavalcano queste regole per costruzione —
// è il loro mestiere, ed è la strada da cui leggono sia la dashboard (via main,
// che decifra) sia il server dei giudici, che le immagini le passa a un modello
// con ingresso visivo. Quindi l'URL col token vale quanto l'allegato: vive
// dentro il documento del feedback, e chiudere la lettura di quei documenti è
// l'ALTRA METÀ di questo confine (#583). Senza token, `?alt=media` passa di qui
// e risponde 403 a chiunque, owner compreso.
//
// ⚠️ Queste regole diventano vere il giorno in cui le si pubblica sul progetto
// Firebase. Finché quel comando non gira, nel repo c'è un confine stretto e in
// produzione la porta è ancora quella di prima: è un passo da fare a mano.

service firebase.storage {
  match /b/{bucket}/o {

    // Nessuna funzione «sei l'amministratore?»: da queste regole non legge
    // nessuno, nemmeno lui (vedi `get: if false` più sotto). Il ramo che
    // chiedeva l'allowlist `admins` di Firestore con le regole cross-service è
    // stato tolto quando la lettura si è chiusa del tutto: un permesso che
    // nessuno usa è solo una porta in più, e per di più era l'unica riga che
    // in laboratorio non si riusciva a misurare (il motore degli emulatori al
    // database quella domanda non la gira).

    // Solo il tipo dei blob cifrati (#1518): con la lista dei tipi «passivi» chiunque, senza
    // mandare un feedback, ci teneva un file qualunque dietro un link che non scade. Tipo ed
    // estensione vengono da `SN_FEEDBACK` (src/shared/feedback.js): la sentinella li confronta.
    function soloCifrato() {
      return request.resource.contentType == 'application/octet-stream';
    }

    // Il tetto è il limite del client (4 MB per allegato, misurato sul file
    // COM'È) più il gonfiore della cifratura S1.2. Senza quel margine un
    // allegato da 4 MB tondi passava il controllo dell'app e veniva respinto
    // qui, cifrato: un rifiuto che nasce dalla differenza fra due misure della
    // stessa cosa, e che l'utente legge come "caricamento non riuscito".
    function dimensioneAmmessa() {
      return request.resource.size <= 4 * 1024 * 1024 + 64 * 1024;
    }

    // Nome con entropia: <etichetta_>?<millisecondi>_<uuid>.octetstream.
    // L'uuid è la parte che non si indovina; l'etichetta facoltativa distingue
    // la provenienza (`agent_` per i ritrovamenti dell'agente esploratore).
    // L'estensione è fissa: libera, il link diventava `fattura.exe`.
    function nomeConEntropia(file) {
      return file.matches('^([a-z]{1,16}_)?[0-9]{10,17}_[0-9a-fA-F]{8}-?[0-9a-fA-F]{4}-?[0-9a-fA-F]{4}-?[0-9a-fA-F]{4}-?[0-9a-fA-F]{12}\\.octetstream$');
    }

    // Nessuna chiave né nome di scarico scelti da chi carica (#1518): passano solo il codice di scarico e le
    // forme di Content-Disposition che Firebase scrive da sé. Codifica, cache e lingua NON si leggono (#1769):
    // il deposito vero le riempie da sé (probabile la codifica «identity»), e ogni regola su di loro ha negato
    // ogni caricamento vero dal 23/10, verde a emulatore e API di prova. Sceglierle su un blob opaco servito
    // solo col codice non cambia tipo né nome di scarico: rischio accettato. Regole: storageRulesAllegati.test.
    function senzaMetadatiScelti(r, file) {
      return (!('metadata' in r) || r.metadata == null
          || r.metadata.keys().hasOnly(['firebaseStorageDownloadTokens']))
        && (!('contentDisposition' in r) || r.contentDisposition == null
          || r.contentDisposition in ['', 'inline', "inline; filename*=utf-8''" + file]);
    }

    match /feedback/{file} {
      // Da qui non scarica nessuno (#583): l'unica chiave è il download token
      // dentro il link, che Firebase valuta PRIMA delle regole. Chiuderlo anche
      // all'owner è ciò che rende utile ruotare il token di un file finito in
      // giro: finché il `get` era aperto, quella cura non serviva a niente.
      allow get: if false;
      // `list` non è concesso da nessuna riga: elencare il bucket non si può,
      // per nessuno. La dashboard non elenca — apre gli allegati che il
      // documento del feedback nomina.
      allow list: if false;

      allow create: if resource == null
        && dimensioneAmmessa()
        && soloCifrato()
        && nomeConEntropia(file)
        && senzaMetadatiScelti(request.resource, file);

      // Un allegato non si sovrascrive e non si cancella: quello che il
      // mittente ha spedito resta quello che l'owner e i giudici leggono.
      allow update, delete: if false;
    }

    // Tutto il resto è chiuso — comprese le sottocartelle di feedback/, che il
    // blocco qui sopra (un solo segmento) non copre.
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
