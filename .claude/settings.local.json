{
  "permissions": {
    "allow": [
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git status:*)",
      "Bash(git branch:*)",
      "Bash(git worktree:*)",
      "Bash(git merge:*)",
      "Bash(git checkout:*)",
      "Bash(npm install:*)",
      "Bash(npm test:*)",
      "Bash(npm run:*)",
      "Bash(npm start:*)",
      "Bash(npx playwright:*)",
      "Bash(node tests/smoke.mjs)",
      "Bash(git -C \"C:/Users/agenti AI/Desktop/Filo/Filo\" pull --rebase origin main)",
      "PowerShell(git -C \"C:/Users/agenti AI/Desktop/Filo/Filo\" pull --rebase origin main)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh\""
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-end.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/auto-commit-merge.sh\""
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/branch-guard.sh\""
          }
        ]
      },
      {
        "matcher": "^(?!(?:Bash|PowerShell|BashOutput|KillShell|Monitor|Grep|Glob|LS|Edit|MultiEdit|Write|NotebookEdit|TodoWrite|TaskCreate|TaskGet|TaskList|TaskUpdate|TaskStop|CronCreate|CronDelete|CronList|EnterPlanMode|ExitPlanMode|EnterWorktree|ExitWorktree|AskUserQuestion|Skill|SlashCommand|PushNotification|SendUserFile|SubagentHandback)$).*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/letture-esterne.sh\""
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "^(?!(?:Bash|PowerShell|BashOutput|KillShell|Monitor|Grep|Glob|LS|Edit|MultiEdit|Write|NotebookEdit|TodoWrite|TaskCreate|TaskGet|TaskList|TaskUpdate|TaskStop|CronCreate|CronDelete|CronList|EnterPlanMode|ExitPlanMode|EnterWorktree|ExitWorktree|AskUserQuestion|Skill|SlashCommand|PushNotification|SendUserFile|SubagentHandback)$).*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/letture-esterne.sh\""
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/cap-observe.sh\""
          }
        ]
      }
    ]
  },
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "opus",
    "CLAUDE_CODE_FORK_SUBAGENT": "0",
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "3"
  }
}
