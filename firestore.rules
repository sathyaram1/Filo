rules_version = '2';

// Regole per l'alpha test di Filo.
//
// Modello di sicurezza (vedi Filo/SECURITY.md):
// - Chiunque può CREARE un feedback (anonimo, nessun login).
// - La LETTURA è pubblica (serve alla dashboard e alla futura pagina pubblica
//   dei feedback). NB: per questo le `notes` sono leggibili da tutti — non
//   metterci dentro segreti.
// - Solo gli ADMIN (email nella collezione `admins`) possono fare triage
//   (update di stato/note/priorità) o cancellare. L'identità admin è provata
//   da un token Google verificato inviato come `Authorization: Bearer <idToken>`.
//
// Gli admin si gestiscono dalla console Firebase aggiungendo un documento in
// `admins/` con l'email come ID. Le regole NON permettono di modificare
// `admins` dal client (niente privilege escalation): si tocca solo da console.
//
// RUOLO "routines" (limitato). Le routine cloud (Claude su claude.ai) fanno
// triage automatico ma NON sono admin pieni: possono solo spostare un feedback
// tra `todo`, `done` e `clarify` e scriverne le `notes`/`resolvedAt`. NON
// possono cancellare, marcare `verified`/`ignored`, toccare la `priority`, né
// scrivere su altre collezioni. L'identità routine si prova come quella admin
// (token Google verificato), ma l'allowlist sta nella collezione `routines`,
// anch'essa gestita SOLO da console. Così, anche se il refresh token della
// routine trapelasse (la piattaforma routine non ha un secret store sicuro),
// il danno massimo è rimescolare gli stati di triage: nessuna distruzione di
// dati né escalation di privilegi.

service cloud.firestore {
  match /databases/{database}/documents {

    // Un richiedente è admin se è loggato con email verificata ed esiste un
    // documento `admins/<sua-email>`. exists() è una lettura privilegiata del
    // motore di regole: non dipende dalle regole di read di `admins`.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/admins/$(request.auth.token.email));
    }

    // Un richiedente è una routine se è loggato con email verificata ed esiste
    // un documento `routines/<sua-email>`. Ruolo deliberatamente debole.
    function isRoutine() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/routines/$(request.auth.token.email));
    }

    // Allowlist amministratori. Gestita SOLO da console Firebase.
    match /admins/{email} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Allowlist routine. Gestita SOLO da console Firebase.
    match /routines/{email} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Config "modelli predefiniti" condivisa, propagata a tutte le installazioni.
    // Scrittura riservata agli admin (l'editor in app passa dal main con il
    // Firebase ID token come Bearer).
    //
    // config/models  → provider/models/modelRegistry. NON è segreto
    //   (sono solo nomi di modelli): lettura PUBBLICA, così anche un utente non
    //   loggato riceve la config predefinita.
    // config/secrets → apiKeys predefinite (openrouter/gemini/tavily). SONO
    //   segrete: lettura solo per utenti loggati (consumate esclusivamente nel
    //   main process, mai inviate alle pagine). Chi non è loggato ricade sulle
    //   chiavi di build.
    match /config/models {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /config/secrets {
      allow read: if request.auth != null
        && request.auth.token.email_verified == true;
      allow write: if isAdmin();
    }

    // config/automation → interruttore master dell'auto-miglioramento (vedi
    // filo-security DESIGN §2). Campo `enabled` (bool; assente = false = OFF, lo
    // stato sicuro). Lo legge la dashboard owner e, in futuro, il backend di
    // sicurezza (admin SDK, che bypassa le regole). Riservato agli admin:
    // nessun utente normale lo legge o scrive.
    match /config/automation {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /feedback/{doc} {
      allow read: if true;

      // Creazione admin: senza vincoli di forma. Serve all'applier locale
      // dell'owner (npm run feedback:apply col token admin) per creare i
      // sub-feedback accodati dalle routine, che portano campi non previsti
      // dal create anonimo (status, notes, seq/subSeq, priority…).
      allow create: if isAdmin();

      // `name` = titolo breve generato da un LLM all'invio; `seq`/`subSeq` =
      // numero progressivo leggibile (#22, #22.1) calcolato dal client.
      allow create: if
        request.resource.data.keys().hasOnly(
          ['text', 'url', 'title', 'name', 'userAgent', 'clientId', 'images',
           'files', 'createdAt', 'seq', 'subSeq']
        )
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 10000
        && request.resource.data.get('url', '') is string
        && request.resource.data.get('url', '').size() <= 2000
        && request.resource.data.get('title', '') is string
        && request.resource.data.get('title', '').size() <= 500
        && request.resource.data.get('name', '') is string
        && request.resource.data.get('name', '').size() <= 200
        && request.resource.data.get('userAgent', '') is string
        && request.resource.data.get('userAgent', '').size() <= 500
        && request.resource.data.get('clientId', '') is string
        && request.resource.data.get('clientId', '').size() <= 100
        && request.resource.data.get('images', []) is list
        && request.resource.data.get('images', []).size() <= 5
        && request.resource.data.get('files', []) is list
        && request.resource.data.get('files', []).size() <= 5
        && request.resource.data.get('seq', 0) is int
        && request.resource.data.get('seq', 0) >= 0
        && request.resource.data.get('seq', 0) <= 1000000
        && request.resource.data.get('subSeq', 0) is int
        && request.resource.data.get('subSeq', 0) >= 0
        && request.resource.data.get('subSeq', 0) <= 100000;

      // Triage admin (pieno): campi di stato/note/priorità/timestamp, più
      // numero e titolo (per backfill/rinomina). Il resto resta immutabile.
      // `claimedBy`/`claimedAt`/`claimExpiresAt`/`claimNum` = "semaforo" che una
      // routine ha preso in carico il feedback (vedi scripts/claim-feedback.mjs).
      // Il lock vero vive su git; questi campi servono SOLO alla dashboard per
      // mostrare "in lavorazione". Sono stringhe (ISO/etichetta); '' = libero.
      allow update: if
        isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'notes', 'resolvedAt', 'verifiedAt', 'priority',
                    'name', 'seq', 'subSeq', 'branch',
                    'claimedBy', 'claimedAt', 'claimExpiresAt', 'claimNum',
                    'reviewDecision', 'reviewComment', 'reviewedAt'])
        && request.resource.data.get('status', 'new') in ['new', 'draft', 'todo', 'clarify', 'review', 'blocked', 'done', 'verified', 'ignored']
        && request.resource.data.get('notes', '') is string
        && request.resource.data.get('notes', '').size() <= 10000
        && request.resource.data.get('priority', 0) is int
        && request.resource.data.get('priority', 0) >= 0
        && request.resource.data.get('priority', 0) <= 3
        && request.resource.data.get('name', '') is string
        && request.resource.data.get('name', '').size() <= 200
        && request.resource.data.get('seq', 0) is int
        && request.resource.data.get('seq', 0) >= 0
        && request.resource.data.get('subSeq', 0) is int
        && request.resource.data.get('subSeq', 0) >= 0
        && request.resource.data.get('claimedBy', '') is string
        && request.resource.data.get('claimedBy', '').size() <= 120
        && request.resource.data.get('claimedAt', '') is string
        && request.resource.data.get('claimedAt', '').size() <= 40
        && request.resource.data.get('claimExpiresAt', '') is string
        && request.resource.data.get('claimExpiresAt', '').size() <= 40
        && request.resource.data.get('claimNum', '') is string
        && request.resource.data.get('claimNum', '').size() <= 20
        // `branch`: nome del branch git su cui vive il fix in attesa di verifica
        // (stati `review`/`blocked` del cancello di merge delle routine).
        && request.resource.data.get('branch', '') is string
        && request.resource.data.get('branch', '').size() <= 200;

      // Triage routine (limitato): può solo spostare tra `todo`/`done`/`clarify`
      // e scrivere `notes`/`resolvedAt`. NON tocca `priority`, NON marca
      // `verified`/`ignored`, NON cancella. Più stretto del ramo admin di
      // proposito: è il contenimento del blast radius del ruolo routine.
      allow update: if
        isRoutine()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'notes', 'resolvedAt'])
        && request.resource.data.get('status', 'new') in ['todo', 'done', 'clarify']
        && request.resource.data.get('notes', '') is string
        && request.resource.data.get('notes', '').size() <= 10000;

      // Cancellazione: solo admin.
      allow delete: if isAdmin();
    }

    // Crediti (gamification): un documento per utente, ID = uid Firebase.
    // Ogni utente legge/scrive SOLO il proprio doc. È client-authoritative:
    // l'app desktop calcola saldo/consumo nel main e sincronizza qui. In alpha
    // accettiamo il caveat (un utente potrebbe gonfiarsi i crediti manomettendo
    // il client): i crediti non danno accesso a risorse altrui né a dati di
    // altri utenti, quindi il blast radius è solo "barare col proprio saldo".
    // Se in futuro i crediti diventano spendibili per davvero, va spostato il
    // calcolo su una Cloud Function autorevole.
    // Oltre al proprietario, anche un ADMIN può leggere e scrivere qualsiasi
    // doc credits: serve ai comandi proprietario /users (elenco utenti) e /gift
    // (accredito crediti a un altro account). L'app desktop sincronizza qui
    // anche `email`/`name` dell'utente, così l'admin può risolvere email→uid e
    // listare gli iscritti. Resta client-authoritative per il saldo proprio.
    match /credits/{uid} {
      allow read, write: if request.auth != null
        && request.auth.uid == uid;
      allow read, write: if isAdmin();
    }

    // Percorsi di navigazione raccolti dalla sidebar "Aiuto" (Fase 2).
    // Tupla anonima (sito, posizione iniziale, intento, azioni, esito) usata
    // per insegnare globalmente all'AI come muoversi su un dominio.
    // Lo schema è validato a monte dal client: la raccolta passa per due LLM
    // distinti (intent guess + judge) che impediscono che dati raw dell'utente
    // finiscano qui dentro. Le regole sotto fanno solo il check di forma.
    match /paths/{doc} {
      allow read: if true;

      allow create: if
        request.resource.data.keys().hasOnly(
          ['domain', 'initialUrl', 'intent', 'steps', 'success',
           'userAgent', 'clientId', 'createdAt']
        )
        && request.resource.data.domain is string
        && request.resource.data.domain.size() > 0
        && request.resource.data.domain.size() <= 253
        && request.resource.data.initialUrl is string
        && request.resource.data.initialUrl.size() <= 2000
        && request.resource.data.intent is string
        && request.resource.data.intent.size() <= 500
        && request.resource.data.steps is list
        && request.resource.data.steps.size() <= 30
        && request.resource.data.success is bool
        && request.resource.data.get('userAgent', '') is string
        && request.resource.data.get('userAgent', '').size() <= 500
        && request.resource.data.get('clientId', '') is string
        && request.resource.data.get('clientId', '').size() <= 100;

      allow update: if false;
      allow delete: if false;
    }

    // ── Collezioni del backend di sicurezza (filo-security, DESIGN §13) ──────
    // Scritte SOLO dal backend server-side via Admin SDK, che BYPASSA queste
    // regole. Per il client sono di sola lettura admin (futuri pannelli di
    // audit dell'owner) e MAI scrivibili: niente accesso utente.
    //
    // - identities/* : stato per account/IP (clean/spam/dangerous), contatori.
    // - attacks/*    : corpus dei tentativi (testo, verdetti, sorgente etichetta).
    // - judge-verdicts/* : log dei giudizi L2 (audit/benchmark).
    // La logica e i prompt dei giudici NON vivono qui (sono nel backend
    // privato): queste collezioni contengono solo stato/dati, non il "cervello".
    match /identities/{doc} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /attacks/{doc} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /judge-verdicts/{doc} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ── Canale red-team (filo-redteam-ux-spec §9, DESIGN §9) ─────────────────
    // SERVER-AUTHORITATIVE: scritto SOLO dal backend via Admin SDK (bypassa
    // queste regole). Il client NON scrive MAI — altrimenti un utente si
    // auto-verificherebbe, falsificherebbe punteggi/ricompense o si auto-
    // attribuirebbe verdetti. Le LETTURE del client passano tutte da Cloud
    // Function (redteamState/redteamAttempt/redteamLeaderboard, Admin SDK), che
    // applicano il gating (proprietario, verificato). Quindi qui la lettura
    // diretta è negata al client (solo admin, per pannelli owner futuri).
    //
    // redteam-users/{uid} : verifica + handle + stato gamification (bestPerJudge,
    //   gridUnlocked, milestones, leaderboardScore) + contatori. Lettura del
    //   PROPRIO doc consentita (abilita un eventuale listener real-time; non
    //   espone dati altrui), oltre all'admin.
    match /redteam-users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow read: if isAdmin();
      allow write: if false;
    }
    // redteam-attempts/{id} : tentativi (testo, descrizione, verdetti, score). I
    //   non verificati NON devono vedere i risultati (spec §7.1): per non
    //   replicare quel gating nelle regole, la lettura diretta è solo admin; il
    //   client usa la callable redteamAttempt (che verifica proprietà + stato).
    match /redteam-attempts/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
    // redteam-codes/{code} : codici monouso. Il codice è l'UNICA prova di
    //   abilitazione: se il client potesse leggerli si verificherebbe da solo →
    //   lettura solo admin, scrittura solo server-side (riscatto/generazione).
    match /redteam-codes/{code} {
      allow read: if isAdmin();
      allow write: if false;
    }
    // redteam-handles/{h} : prenotazione handle (unicità leaderboard). Solo backend.
    match /redteam-handles/{h} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
