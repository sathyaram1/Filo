          && aForma(d.carta_home, '^([A-Za-z][A-Za-z0-9]{0,39}(#[A-Za-z][A-Za-z0-9]{0,39})*)?$', 2000, 9000, '^(((mostra|aggiungi|togli|ripristina|ordina)|(sinistra|destra|altro)[|](clic|invio|tasto_destro))[|][0-9]{1,9}(;((mostra|aggiungi|togli|ripristina|ordina)|(sinistra|destra|altro)[|](clic|invio|tasto_destro))[|][0-9]{1,9})*(#((mostra|aggiungi|togli|ripristina|ordina)|(sinistra|destra|altro)[|](clic|invio|tasto_destro))[|][0-9]{1,9}(;((mostra|aggiungi|togli|ripristina|ordina)|(sinistra|destra|altro)[|](clic|invio|tasto_destro))[|][0-9]{1,9})*)*)?$')
