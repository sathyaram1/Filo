rules_version = '2';

// Regole per l'alpha test di Filo.
//
// Modello di sicurezza (vedi Filo/SECURITY.md):
// - Chiunque può CREARE un feedback (anonimo, nessun login).
// - La LETTURA dei documenti feedback NON è pubblica (audit pre-alpha, #583).
//   Fino ad agosto 2026 era `allow read: if true`: testo e URL erano cifrati
//   per l'owner, ma tutto il resto no — titolo, user agent, link agli
//   screenshot, numero, data — e i documenti anteriori al cutover della
//   cifratura (25 giugno 2026) erano in chiaro per intero, note di lavorazione
//   comprese. Con la sola chiave web del repo un estraneo ricostruiva cosa
//   stanno provando i tester e su quali pagine. Ora leggono solo l'owner
//   (admin) e il server dei giudici/routine (identità propria o Admin SDK, che
//   bypassa queste regole).
// - Chi ha bisogno dei soli campi PUBBLICI — la bacheca degli utenti e il
//   popup delle ricompense — legge `feedback-public`, la VISTA qui sotto:
//   una proiezione con i soli campi sicuri dei feedback chiusi e non
//   segnalati dalla sicurezza. La collezione vera resta chiusa.
// - Solo gli ADMIN (email nella collezione `admins`) possono fare triage
//   (update di stato/note/priorità) o cancellare. L'identità admin è provata
//   da un token Google verificato inviato come `Authorization: Bearer <idToken>`.
//
// Gli admin si gestiscono dalla console Firebase aggiungendo un documento in
// `admins/` con l'email come ID. Le regole NON permettono di modificare
// `admins` dal client (niente privilege escalation): si tocca solo da console.
//
// RUOLO "routines" (limitato). Le routine cloud (Claude su claude.ai) fanno
// triage automatico ma NON sono admin pieni: possono solo spostare un feedback
// tra `todo`, `done` e `clarify` e scriverne le `notes`/`resolvedAt`. NON
// possono cancellare, marcare `verified`/`ignored`, toccare la `priority`, né
// scrivere su altre collezioni. L'identità routine si prova come quella admin
// (token Google verificato), ma l'allowlist sta nella collezione `routines`,
// anch'essa gestita SOLO da console. Così, anche se il refresh token della
// routine trapelasse (la piattaforma routine non ha un secret store sicuro),
// il danno massimo è rimescolare gli stati di triage: nessuna distruzione di
// dati né escalation di privilegi.

service cloud.firestore {
  match /databases/{database}/documents {

    // Un richiedente è admin se è loggato con email verificata ed esiste un
    // documento `admins/<sua-email>`. exists() è una lettura privilegiata del
    // motore di regole: non dipende dalle regole di read di `admins`.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/admins/$(request.auth.token.email));
    }

    // Un interruttore «aperto a tutti» dell'owner (config/redteam, config/bacheca,
    // config/mazzi): solo `openToAll` booleano e la data in cui è cambiato.
    function interruttoreValido(d) {
      return d.keys().hasOnly(['openToAll', 'updatedAt'])
        && d.get('openToAll', false) is bool
        && (!('updatedAt' in d)
            || d.updatedAt is timestamp
            || (d.updatedAt is string && d.updatedAt.size() <= 40));
    }

    // Un richiedente è una routine se è loggato con email verificata ed esiste
    // un documento `routines/<sua-email>`. Ruolo deliberatamente debole.
    function isRoutine() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/routines/$(request.auth.token.email));
    }

    // I livelli di sicurezza sul feedback (contratto del 2026-09-13): `livelli`
    // è una mappa con al più `l3` (la segnalazione di chi ha lavorato: un
    // trade-off vero che decide l'owner) e `l4` (l'esito del controllo di
    // sicurezza, anche quando passa, e il salto dell'owner). Li scrive SOLO il
    // server con la sua identità; qui la forma, così una voce storpiata non
    // passa da nessuno dei due rami di triage. `testo` è cifrato come `notes`,
    // e il tetto è abbondante (CLAUDE.md § Limiti): 12.000 byte in chiaro
    // (non caratteri: in cirillico sarebbero il doppio), cifrati, stanno in 20.000.
    function livelloValido(l) {
      return l is map
        && l.keys().hasOnly(['esito', 'at', 'ruolo', 'by', 'testo'])
        && l.get('esito', '') is string
        && l.get('esito', '').size() > 0
        && l.get('esito', '').size() <= 40
        && l.get('at', '') is string
        && l.get('at', '').size() <= 40
        && l.get('ruolo', '') is string
        && l.get('ruolo', '').size() <= 40
        && l.get('by', '') is string
        && l.get('by', '').size() <= 120
        && l.get('testo', '') is string
        && l.get('testo', '').size() <= 20000;
    }
    function livelliValidi(d) {
      return !('livelli' in d)
        || (d.livelli is map
            && d.livelli.keys().hasOnly(['l3', 'l4'])
            && (!('l3' in d.livelli) || livelloValido(d.livelli.l3))
            && (!('l4' in d.livelli) || livelloValido(d.livelli.l4)));
    }

    // `localOnly` { by, at } (#908): la pratica la lavora solo una sessione
    // locale e la coda delle routine la salta. Solo l'admin la scrive (create
    // e ramo di triage admin); assente = feedback normale. `at` in millisecondi.
    function localOnlyValido(d) {
      return !('localOnly' in d)
        || (d.localOnly is map
            && d.localOnly.keys().hasOnly(['by', 'at'])
            && d.localOnly.get('by', '') is string
            && d.localOnly.get('by', '').size() > 0
            && d.localOnly.get('by', '').size() <= 120
            && d.localOnly.get('at', 0) is int
            && d.localOnly.get('at', 0) > 0);
    }

    // `waitsFor` [{ id, num }] (#903): i feedback che devono essere fusi prima; la coda
    // non dà lavoro finché uno non lo è. Solo l'admin; da 1 a 20, e chi scrive rifiuta
    // numeri inesistenti, sé stesso e i giri (src/shared/feedbackAttese.js). Togliere = cancellare il campo.
    function waitsForValido(d) {
      return !('waitsFor' in d)
        || (d.waitsFor is list && d.waitsFor.size() >= 1 && d.waitsFor.size() <= 20);
    }

    // `localMerges` { app?, server?, solo?, ramo? } (#915): quando ogni parte di un
    // lavoro locale è arrivata su main, in millisecondi, `solo` la parte che
    // ha chiuso dicendo che il lavoro stava tutto lì, `ramo` il ramo dell'ultima
    // parte fusa (una parte tardiva vale solo col suo nome). Lo scrivono il server e
    // server:fondi (admin); la pratica si chiude all'ultima parte. Il cancello delle
    // routine ci scrive `worker/…`: fuori forma, ogni update dell'owner cadrebbe (#1336.1).
    function localMergesValido(d) {
      return !('localMerges' in d)
        || (d.localMerges is map
            && d.localMerges.keys().hasOnly(['app', 'server', 'solo', 'ramo'])
            && (!('ramo' in d.localMerges)
                || (d.localMerges.ramo is string && d.localMerges.ramo.size() <= 200
                    && d.localMerges.ramo.matches('^(claude|worker)/[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*$')))
            && (!('app' in d.localMerges) || (d.localMerges.app is int && d.localMerges.app > 0))
            && (!('server' in d.localMerges) || (d.localMerges.server is int && d.localMerges.server > 0))
            && (!('solo' in d.localMerges) || d.localMerges.solo in ['app', 'server']));
    }

    // `localApproval` { by, at } (#913): l'owner approva come lavoro locale il
    // feedback di un utente o di una routine, e alla fusione vale quanto la prova
    // del mittente. Solo l'admin: nessun altro ramo lo nomina (sentinella
    // tests/unit/firestoreRulesLocalOnly.test.mjs). Stessa forma di localOnly.
    // `bigliettoLocale` (#1148): l'impronta del biglietto della sessione locale che
    // crea il feedback; il server ne legge la fiducia alla nascita.
    function bigliettoLocaleValido(d) {
      return !('bigliettoLocale' in d)
        || (d.bigliettoLocale is string && d.bigliettoLocale.size() <= 64);
    }

    function localApprovalValido(d) {
      return !('localApproval' in d)
        || (d.localApproval is map
            && d.localApproval.keys().hasOnly(['by', 'at'])
            && d.localApproval.get('by', '') is string
            && d.localApproval.get('by', '').size() > 0
            && d.localApproval.get('by', '').size() <= 120
            && d.localApproval.get('at', 0) is int
            && d.localApproval.get('at', 0) > 0);
    }

    // Gli allegati li scarica il server, con la chiave dei feedback in memoria (#597): in `images` e in
    // `files[].url` entrano solo indirizzi del NOSTRO deposito, nella forma dei caricatori di Filo
    // (src/shared/feedback.js uploadImage, tests/agent/feedback.mjs). Il server rifà il controllo prima di
    // scaricare. Sentinelle: tests/unit/firestoreRulesAllegati.test.mjs e feedbackAllegati.motore-vero.mjs.
    function indirizzoAllegato(u) {
      return u is string && u.size() <= 2000
        && u.matches('^https://firebasestorage[.]googleapis[.]com/v0/b/filo-8b9cb[.]firebasestorage[.]app/o/feedback%2F(agent_)?[0-9]{10,17}_[0-9a-f]{8}-?[0-9a-f]{4}-?[0-9a-f]{4}-?[0-9a-f]{4}-?[0-9a-f]{12}[.][a-z0-9]{1,12}[?]alt=media&token=[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$');
    }
    function documentoAllegato(f) {
      return f is map && indirizzoAllegato(f.get('url', ''));
    }
    // Le regole non hanno cicli: una riga per posto, fino al tetto di 5.
    function immaginiValide(l) {
      return l is list && l.size() <= 5
        && (l.size() < 1 || indirizzoAllegato(l[0]))
        && (l.size() < 2 || indirizzoAllegato(l[1]))
        && (l.size() < 3 || indirizzoAllegato(l[2]))
        && (l.size() < 4 || indirizzoAllegato(l[3]))
        && (l.size() < 5 || indirizzoAllegato(l[4]));
    }
    function documentiValidi(l) {
      return l is list && l.size() <= 5
        && (l.size() < 1 || documentoAllegato(l[0]))
        && (l.size() < 2 || documentoAllegato(l[1]))
        && (l.size() < 3 || documentoAllegato(l[2]))
        && (l.size() < 4 || documentoAllegato(l[3]))
        && (l.size() < 5 || documentoAllegato(l[4]));
    }

    // Allowlist amministratori. Gestita SOLO da console Firebase.
    match /admins/{email} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Le domande all'owner (#1149, SPEC-DOMANDE.md §3): le scrive solo il server, che decide autore e fiducia di
    // ogni turno; un client che scrivesse qui si darebbe la voce dell'owner. Testi cifrati per l'owner.
    match /domande/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Allowlist routine. Gestita SOLO da console Firebase.
    match /routines/{email} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Config "modelli predefiniti" condivisa, propagata a tutte le installazioni.
    // Scrittura riservata agli admin (l'editor in app passa dal main con il
    // Firebase ID token come Bearer).
    //
    // config/models  → provider/models/modelRegistry. NON è segreto
    //   (sono solo nomi di modelli): lettura PUBBLICA, così anche un utente non
    //   loggato riceve la config predefinita.
    // config/secrets → apiKeys predefinite (openrouter/tavily) e chiave Google
    //   Safe Browsing. SONO segrete: lettura e scrittura SOLO admin, esattamente
    //   come config/judgeSecrets.
    //
    //   Perché non basta "loggato con email verificata" (audit pre-alpha, #581):
    //   il login è aperto a qualunque account Google e la chiave web di Firebase
    //   sta in un repo pubblico. Chiunque, senza nemmeno installare Filo, si
    //   autenticava con quella chiave e con una GET REST si portava via le
    //   chiavi che pagano le chiamate di TUTTI. La condizione "sei loggato" non
    //   è una barriera quando registrarsi costa zero.
    //
    //   Come arrivano allora le chiavi a un utente normale: dalla DISTRIBUZIONE
    //   DEL BUILD. L'admin le scrive qui; la CI (scripts/bake-default-config.mjs,
    //   che le chiede al server con la parola d'ordine di costruzione) le
    //   incastona nell'installer a ogni release; l'auto-update le consegna. È lo
    //   stesso cammino che serviva già gli utenti non loggati, cioè la
    //   maggioranza. Nessuna installazione ha più bisogno di leggere questo
    //   documento: solo la pagina "Modelli predefiniti" dell'admin lo fa, per
    //   scrivere e per dire "configurata / non configurata".
    match /config/models {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /config/secrets {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // config/judgeSecrets → chiave OpenRouter DEDICATA ai giudici di sicurezza,
    // SEPARATA dalle chiavi del resto di Filo (DESIGN §4/§14). L'owner la imposta
    // dalla schermata "Modelli di supporto"; il backend filo-security la legge via
    // Admin SDK (bypassa le regole). Più stretta di config/secrets: lettura e
    // scrittura SOLO admin (nessun altro utente loggato può leggerla). Campo:
    // `openrouterKey` (stringa).
    match /config/judgeSecrets {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // config/automation → config dell'auto-miglioramento (vedi filo-security
    // DESIGN §2). Campi:
    //   - `enabled` (bool; assente = false = OFF, lo stato sicuro): interruttore
    //     dell'ingresso automatico in coda (un feedback giudicato sicuro entra
    //     da solo). NON è l'interruttore delle routine: quello sta in
    //     config/routines, vedi sotto.
    //   - `autoApprove` (mappa categoria d'autore → bool, una voce per ogni
    //     icona che la coda mostra; assente = tutti true): quali mittenti
    //     entrano in coda da soli quando `enabled` è true (#446). La legge il
    //     backend di sicurezza via Admin SDK.
    //   - `workerLog` (array di { role, startedAt, num }): il registro dei worker
    //     mostrato in dashboard. Lo scrive il server (functions, Admin SDK) al
    //     rilascio di ogni biglietto (le routine non hanno credenziali: #451).
    //   - `senderProofSince` ({ local, owner }: ms): storico, non lo legge nessuno.
    // Le regole NON enumerano i campi (read/write admin-only): nuovi campi non
    // richiedono redeploy. Riservato agli admin: nessun utente normale legge/scrive.
    match /config/automation {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // config/routines → come devono comportarsi le routine autonome. Campi:
    //   - `enabled` (bool; assente = true = comportamento storico): interruttore
    //     MASTER delle routine. Spento, l'orchestratore parte ma il dispatcher
    //     non consegna nulla a nessuno.
    //   - `cap3`, `cap2`, `cap1`, `cap0` (int 0-10): giri di correzione per
    //     livello di rilievo, e `fixInstructions` (string): il testo della fase
    //     2. Senza default nel codice — assenti, la verifica si ferma (#561).
    //   - `failCap` (int): quanti fallimenti di fila prima di fermarsi.
    //   - `routineId` / `routineIdB` (string): le routine dei due account.
    //   - `accountBlockMs` (int): la pausa che si prende un account che fallisce.
    //   - `maxSessions` (int 1-20; assente = 1): quante sessioni lavorano
    //     insieme.
    //   - `priorityAccount` ('A'|'B'|''; assente = ''): da quale account si
    //     parte sempre finché regge; vuoto = si alternano.
    //   - `accountAOff` / `accountBOff` (bool; assente = false): account
    //     escluso — da lì non parte nessuna sessione nuova.
    //   - `roleModels` ({ ruolo: { model?, effort? } }; ruoli new-work,
    //     verifier, fixer, secaudit; model opus|sonnet|haiku|fable,
    //     effort low|medium|high|xhigh|max; assente = definizione
    //     dell'agente): modello e sforzo del worker per fase (#1193).
    //
    // LETTURA PUBBLICA, e non è una svista. Chi lo legge sono le macchine delle
    // routine, che NON hanno nessuna credenziale (né service account né token
    // dell'owner). Finché queste tre impostazioni sono vissute in un documento
    // admin-only, la lettura falliva sempre e si ricadeva sui default: la
    // dashboard le mostrava attive e nei fatti non hanno mai raggiunto una
    // routine. Un interruttore che non arriva a destinazione è peggio che
    // assente — e qui dentro non c'è niente di segreto: solo se le routine
    // devono lavorare. La SCRITTURA resta solo all'owner.
    match /config/routines {
      allow read: if true;
      allow write: if isAdmin();
    }

    // config/redteam (#896) → `openToAll`: il Red Team è aperto a chi non è
    // admin? Spento, assente o illeggibile = in pausa; le callable del server lo
    // leggono con l'Admin SDK. Lettura pubblica: dentro c'è un interruttore e
    // basta, e la pagina del Red Team deve poter dire «in pausa» a chiunque.
    match /config/redteam {
      allow read: if true;
      allow create, update: if isAdmin() && interruttoreValido(request.resource.data);
      allow delete: if isAdmin();
    }

    // config/bacheca e config/mazzi (#1592) → `openToAll`, come config/redteam:
    // la Bacheca e il Deck builder sono aperti a chi non è admin? Spento, assente o
    // illeggibile = in pausa. Lettura pubblica: dentro c'è un interruttore e basta.
    match /config/bacheca {
      allow read: if true;
      allow create, update: if isAdmin() && interruttoreValido(request.resource.data);
      allow delete: if isAdmin();
    }
    match /config/mazzi {
      allow read: if true;
      allow create, update: if isAdmin() && interruttoreValido(request.resource.data);
      allow delete: if isAdmin();
    }

    // config/supportModels → modelli per gli slot di supporto (sanitizer,
    // judge1, judge2, judge3, judgeDynamic, judgeRedTeam, judgePriority). Ogni
    // campo è una stringa catena di nickname ("flash, flash-or"), stesso
    // formato di config/models. Le regole NON enumerano i campi (read/write
    // admin-only), quindi nuovi slot non richiedono un redeploy.
    // Lettura riservata agli admin dal client; il backend filo-security la legge
    // via Admin SDK (bypassa queste regole). Scrittura solo admin.
    match /config/supportModels {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /feedback/{doc} {
      // #583 — LA LETTURA NON È PUBBLICA. I lettori legittimi sono due, e
      // hanno ciascuno la sua strada:
      //   · l'owner, dalla dashboard di Gestione, autenticato come admin (il
      //     main process allega il suo ID token: src/main/services/handlers/auth.js);
      //   · il server dei giudici e delle routine, con identità propria
      //     (`routines/<email>`) oppure via Admin SDK, che bypassa le regole.
      // Tutti gli altri bisogni passano dalla vista `feedback-public` sotto.
      // `get` e `list` insieme: chiudere solo la lista lascerebbe leggibile
      // qualunque documento di cui si conosca l'id — e gli id storici sono
      // finiti in link e log.
      allow get, list: if isAdmin() || isRoutine();

      // Creazione admin: pochi vincoli di forma (gli allegati sì, #597). La usano l'app dell'owner e
      // scripts/claude-feedback.mjs col token admin per scrivere `senderProof`
      // (#595), la prova del mittente che il create anonimo sotto NON ammette, né un update dopo:
      // la sentinella tests/unit/firestoreRulesSenderProof.test.mjs lo tiene vero.
      // La fiducia (SPEC-DOMANDE.md §1) e la classe del mittente (§10) le scrive solo l'Admin SDK: nessun client,
      // nemmeno l'admin, che è anche ogni sessione locale. `bigliettoLocale` (impronta
      // del biglietto della sessione) solo qui, alla nascita. Sentinella:
      // tests/unit/firestoreRulesFiducia.test.mjs.
      allow create: if isAdmin() && localOnlyValido(request.resource.data) && localApprovalValido(request.resource.data)
        && waitsForValido(request.resource.data)
        && !request.resource.data.keys().hasAny(['fiducia', 'fiduciaDa', 'genitori', 'mergePreapproved', 'mittenteClasse', 'mittenteRuolo'])
        && bigliettoLocaleValido(request.resource.data)
        && immaginiValide(request.resource.data.get('images', []))
        && documentiValidi(request.resource.data.get('files', []))
        // #676: una data, mai testo (anche qui il giro della Gestione la confronta).
        && (!('updatedAt' in request.resource.data) || request.resource.data.updatedAt is timestamp);

      // `name` = titolo breve generato da un LLM all'invio; `seq`/`subSeq` =
      // numero progressivo leggibile (#22, #22.1) calcolato dal client.
      // `parentId` (DC4): presente solo quando questo feedback è la riapertura
      // di un fix "Risolti" — collega al doc originale (ID Firestore, stessa
      // forma usata altrove nel repo: alfanumerico/`-`/`_`).
      allow create: if
        request.resource.data.keys().hasOnly(
          ['text', 'url', 'title', 'name', 'userAgent', 'clientId', 'clientIdHash', 'images',
           'files', 'createdAt', 'seq', 'subSeq', 'parentId',
           'statusPublic',   // S1.F2.1: aggiunto statusPublic (sempre in chiaro, nuovo nei submit)
           'capabilityGapId', // F4: id gap capacità per dedup auto-feedback (F5)
           'walletPseudonym', // #652: pseudonimo del portafoglio — a chi accreditare il premio
           'updatedAt'       // #676: l'ora dell'ultima scrittura — la dashboard ci chiede "cosa è cambiato?"
          ]
        )
        && (!('updatedAt' in request.resource.data)
            || request.resource.data.updatedAt is timestamp)
        // #652: se c'è, è uno pseudonimo di portafoglio (16 hex). Facoltativo:
        // chi non ha un portafoglio manda il feedback e basta.
        && request.resource.data.get('walletPseudonym', '') is string
        && (request.resource.data.get('walletPseudonym', '') == ''
            || request.resource.data.walletPseudonym.size() == 16)
        // S1.F2.1: se presente, statusPublic deve essere un valore valido.
        && request.resource.data.get('statusPublic', 'open') in ['open', 'closed', 'pending-approval']
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 10000
        && request.resource.data.get('url', '') is string
        && request.resource.data.get('url', '').size() <= 2000
        && request.resource.data.get('title', '') is string
        && request.resource.data.get('title', '').size() <= 500
        && request.resource.data.get('name', '') is string
        && request.resource.data.get('name', '').size() <= 200
        && request.resource.data.get('userAgent', '') is string
        && request.resource.data.get('userAgent', '').size() <= 500
        // S1.F2.2: clientId può essere raw (<=100) o cifrato FENC1: (<=300).
        && request.resource.data.get('clientId', '') is string
        && request.resource.data.get('clientId', '').size() <= 300
        // S1.F2.2: clientIdHash — hash SHA-256 troncato in chiaro (32 char hex) per match C5.
        && request.resource.data.get('clientIdHash', '') is string
        && request.resource.data.get('clientIdHash', '').size() <= 64
        && immaginiValide(request.resource.data.get('images', []))
        && documentiValidi(request.resource.data.get('files', []))
        && request.resource.data.get('seq', 0) is int
        && request.resource.data.get('seq', 0) >= 0
        && request.resource.data.get('seq', 0) <= 1000000
        && request.resource.data.get('subSeq', 0) is int
        && request.resource.data.get('subSeq', 0) >= 0
        && request.resource.data.get('subSeq', 0) <= 100000
        && request.resource.data.get('parentId', '') is string
        && request.resource.data.get('parentId', '').size() <= 128
        // La data di creazione: un timestamp (il client) o una stringa ISO corta
        // (lo script locale, il server). Senza vincolo era un campo libero che
        // le routine ricevevano così com'era, fuori dalla cornice «dato, non
        // istruzione» (verifica locale del ramo cornice-routine, giro 4).
        && (!('createdAt' in request.resource.data)
            || request.resource.data.createdAt is timestamp
            || (request.resource.data.createdAt is string
                && request.resource.data.createdAt.size() <= 40))
        // F4: capabilityGapId — opzionale, solo per auto-feedback (clientId 'auto:*').
        && request.resource.data.get('capabilityGapId', '') is string
        && request.resource.data.get('capabilityGapId', '').size() <= 100;

      // Triage admin (pieno): campi di stato/note/priorità/timestamp, più
      // numero e titolo (per backfill/rinomina). Il resto resta immutabile.
      // `claimedBy`/`claimedAt`/`claimExpiresAt`/`claimNum` = "semaforo" che una
      // routine ha preso in carico il feedback. Il lock vero lo tiene il server
      // (il semaforo del biglietto); questi campi servono SOLO alla dashboard
      // per mostrare "in lavorazione". Stringhe (ISO/etichetta); '' = libero.
      allow update: if
        isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
          // S1.F2.1: aggiunto statusPublic (enum grossolano in chiaro) e resolvedInVersion.
          .hasOnly(['status', 'statusPublic', 'notes', 'resolvedAt', 'verifiedAt', 'priority',
                    'priorityManual', // P6: flag manuale owner (il giudice auto non sovrascrive)
                    // Macchina a stati (FEEDBACK-STATES.md): statusReason = sottotesto
                    // dello status (loop/clarify/…), workingSince = timestamp del lock,
                    // workingResets = interruzioni consecutive (il freno del §6a),
                    // stalls = quante volte in tutto (non si azzera: è il numero che
                    // l'owner legge nella coda), beatAt = ultimo battito arrivato al
                    // server per quel lavoro, che la dashboard usa per dire il vero su
                    // "qualcuno ci sta lavorando ORA".
                    'statusReason', 'workingSince', 'workingResets', 'stalls', 'beatAt',
                    'name', 'seq', 'subSeq', 'branch', 'blockReason', 'starred',
                    'claimedBy', 'claimedAt', 'claimExpiresAt', 'claimNum',
                    'reviewDecision', 'reviewComment', 'reviewedAt', 'resolvedInVersion',
                    // I DUE TESTI: 'notes' e' il report per l'owner (cifrato),
                    // 'userNote' la frase in chiaro per chi ha mandato il feedback.
                    'userNote',
                    'archiveOverride', 'reopenRequests',
                    // #676: l'ora dell'ultima scrittura, firmata da chi scrive.
                    // È il campo su cui la dashboard chiede «cosa è cambiato
                    // da allora?» invece di rileggere la collezione a ogni
                    // giro: chi scrive un feedback senza rimetterlo rende quel
                    // cambiamento invisibile fino alla riconciliazione.
                    'updatedAt',
                    // I livelli L3/L4 (vincolo di forma: livelliValidi, in cima).
                    'livelli',
                    // #908: il segno «solo in locale» (forma: localOnlyValido).
                    'localOnly',
                    // #915: le parti del lavoro locale già su main (forma: localMergesValido).
                    'localMerges',
                    // #913: l'approvazione dell'owner come lavoro locale (forma: localApprovalValido).
                    'localApproval',
                    // #903: i feedback che aspetta (forma: waitsForValido).
                    'waitsFor',
                    // `senderProof` no: la prova nasce col documento, dopo non la scrive nessun client (#1037).
                    'capabilityGapId']) // F4: permettere update del gap id (backfill)
        // S1.F2.1: status accetta l'enum esistente O un ciphertext FENC1: (gate on).
        // Enum: stati CANONICI della macchina a stati (FEEDBACK-STATES.md) +
        // legacy ritirati (documenti storici non ancora migrati).
        && (request.resource.data.get('status', 'new') in
              ['unlabeled', 'suspicious_file', 'attack', 'spam', 'design', 'aligned',
               'todo', 'working', 'revision_capability', 'revision_security', 'done',
               'archived', 'attack_confirmed', 'spam_confirmed',
               'new', 'draft', 'clarify', 'review', 'blocked', 'verified', 'ignored']
            || request.resource.data.get('status', '').matches('^FENC1:.*'))
        // S1.F2.1: statusPublic (se presente) deve essere uno dei tre valori grossolani.
        && request.resource.data.get('statusPublic', 'open') in ['open', 'closed', 'pending-approval']
        && request.resource.data.get('statusReason', '') is string
        && request.resource.data.get('statusReason', '').size() <= 60
        && request.resource.data.get('workingSince', '') is string
        && request.resource.data.get('workingSince', '').size() <= 40
        // `workingResets`: contatore delle lavorazioni interrotte di fila
        // (working scaduto → todo); alla soglia la riconciliazione passa a
        // design/loop. Piccolo per costruzione.
        && request.resource.data.get('workingResets', 0) is int
        && request.resource.data.get('workingResets', 0) >= 0
        && request.resource.data.get('workingResets', 0) <= 100
        // `notes` = CONVERSAZIONE del feedback (report delle routine + risposte
        // dell'owner + righe-allegato): cresce a ogni turno. Il tetto vale per
        // il documento RISULTANTE, quindi note oltre il limite bloccherebbero
        // QUALUNQUE scrittura sul feedback (anche il solo cambio di stato) —
        // il feedback diventerebbe immobile. Tenere allineato a
        // SN_FEEDBACK_THREAD.NOTES_MAX (src/shared/feedbackThread.js), che
        // taglia i turni più vecchi lato scrittura: 400.000 byte in chiaro,
        // cifrati, stanno in 540.000.
        && request.resource.data.get('notes', '') is string
        && request.resource.data.get('notes', '').size() <= 540000
        // La frase per l'utente e' corta per costruzione: e' l'unico dei due
        // testi che resta leggibile da tutti, e un tetto stretto la tiene tale.
        && request.resource.data.get('userNote', '') is string
        && request.resource.data.get('userNote', '').size() <= 500
        // S1.priority: priority accetta int 0-3 (legacy in chiaro) OPPURE
        // una stringa ciphertext FENC1: (gate on). Retrocompatibile.
        && (
             (request.resource.data.get('priority', 0) is int
              && request.resource.data.get('priority', 0) >= 0
              && request.resource.data.get('priority', 0) <= 3)
             || (request.resource.data.get('priority', '') is string
                 && request.resource.data.get('priority', '').matches('^FENC1:.*'))
           )
        && request.resource.data.get('name', '') is string
        && request.resource.data.get('name', '').size() <= 200
        && request.resource.data.get('seq', 0) is int
        && request.resource.data.get('seq', 0) >= 0
        && request.resource.data.get('subSeq', 0) is int
        && request.resource.data.get('subSeq', 0) >= 0
        && request.resource.data.get('claimedBy', '') is string
        && request.resource.data.get('claimedBy', '').size() <= 120
        && request.resource.data.get('claimedAt', '') is string
        && request.resource.data.get('claimedAt', '').size() <= 40
        && request.resource.data.get('claimExpiresAt', '') is string
        && request.resource.data.get('claimExpiresAt', '').size() <= 40
        && request.resource.data.get('claimNum', '') is string
        && request.resource.data.get('claimNum', '').size() <= 20
        // `branch`: nome del branch git su cui vive il fix in attesa di verifica
        // (stati `review`/`blocked` del cancello di merge delle routine).
        && request.resource.data.get('branch', '') is string
        && request.resource.data.get('branch', '').size() <= 200
        // `blockReason`: motivo strutturato del blocco (es. 'loop' = 3 FAIL del
        // verifier→fixer). Usato dalla dashboard `manage` per il colore del bordo.
        && request.resource.data.get('blockReason', '') is string
        && request.resource.data.get('blockReason', '').size() <= 60
        // `starred` (DB2): flag ⭐ "preferito"/parcheggiato, settabile su
        // qualunque feedback dall'owner. Booleano puro.
        && request.resource.data.get('starred', false) is bool
        // `priorityManual` (P6): flag booleano — l'owner ha impostato la priorità
        // a mano. Il giudice automatico (filo-security) lo rispetta e non sovrascrive.
        && request.resource.data.get('priorityManual', false) is bool
        // Override di revisione: l'owner sblocca/conferma a mano un feedback
        // fermato dalla sicurezza, con un commento opzionale. `reviewDecision`
        // 'accepted' lo riammette nel flusso (vedi SN_MANAGE_REVIEW.classifyBlock).
        //
        // #476: i tre campi ora viaggiano CIFRATI (in chiaro dicevano a chi
        // aveva mandato il feedback che era stato fermato). Le regole non
        // possono più enumerare i valori — un ciphertext è una stringa opaca —
        // quindi restano forma e tetto, che è ciò che le regole sanno fare.
        // I valori storici in chiaro continuano a passare.
        && request.resource.data.get('reviewDecision', '') is string
        && request.resource.data.get('reviewDecision', '').size() <= 400
        // #476: il commento ora viaggia CIFRATO (lo leggeva chiunque, compreso
        // chi aveva mandato l'attacco che l'owner stava confermando). La
        // cifratura gonfia il testo di circa il 40% più un preambolo fisso:
        // 2000 caratteri scritti diventano ~2800. Il tetto sale di conseguenza,
        // altrimenti un commento lungo verrebbe respinto qui — stesso
        // ragionamento del `clientId` (grezzo ≤100, cifrato ≤300).
        && request.resource.data.get('reviewComment', '') is string
        && request.resource.data.get('reviewComment', '').size() <= 4000
        && request.resource.data.get('reviewedAt', '') is string
        && request.resource.data.get('reviewedAt', '').size() <= 400   // cifrato (#476)
        // Override owner per l'archiviazione automatica a punteggio (DC3):
        // 'archived' = l'owner ha archiviato a mano (vince sempre su punteggio
        // /età); 'keep_open' = l'owner ha deciso esplicitamente di NON
        // archiviare nonostante il punteggio. '' = nessun override (substrato
        // SN_BOARD_ARCHIVE.hasOwnerOverride).
        && request.resource.data.get('archiveOverride', '') in ['', 'archived', 'keep_open']
        // #676: una DATA, mai testo. Scritta come testo il confronto per data
        // non la riconosce, e quel feedback resta fuori dal giro per sempre.
        && (!('updatedAt' in request.resource.data)
            || request.resource.data.updatedAt is timestamp)
        // `reopenRequests` (DC4): l'admin può azzerarlo (es. {}) quando un fix
        // riaperto viene risistemato e rispedito, sbloccando una futura
        // riapertura sullo stesso doc. Nessun vincolo di forma extra qui: il
        // ramo non-admin sotto resta l'unico modo per gli utenti di scriverlo.
        && request.resource.data.get('reopenRequests', {}) is map
        && livelliValidi(request.resource.data)
        && localOnlyValido(request.resource.data)
        && localMergesValido(request.resource.data)
        && localApprovalValido(request.resource.data)
        && waitsForValido(request.resource.data)
        // F4: capabilityGapId (opzionale) — id strutturale del gap di capacità
        // per il dedup auto-feedback. Stringa breve.
        && request.resource.data.get('capabilityGapId', '') is string
        && request.resource.data.get('capabilityGapId', '').size() <= 100;

      // Voto di verifica della board utente (DB4): un utente LOGGATO scrive SOLO
      // il proprio voto nel map `votes` (chiave = suo uid). Un voto per utente,
      // cambiabile (ri-PATCH della stessa chiave) e ritirabile (cancellazione
      // della chiave). La read del feedback è già pubblica. Il vincolo
      // chiave==uid impedisce di toccare i voti altrui o qualunque altro campo:
      // l'unica chiave del map che può cambiare è quella del richiedente.
      // Entry: { vote: 'works'|'broken', at: <ISO>, credibilitySnapshot: <num> }.
      // È il substrato che board (DC*) e archiviazione a punteggio (DC3) leggono.
      allow update: if
        request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes'])
        && request.resource.data.get('votes', {}) is map
        && request.resource.data.get('votes', {})
             .diff(resource.data.get('votes', {})).affectedKeys()
             .hasOnly([request.auth.uid])
        && (
             !(request.auth.uid in request.resource.data.get('votes', {}))
             || (
                  request.resource.data.votes[request.auth.uid].keys()
                    .hasOnly(['vote', 'at', 'credibilitySnapshot'])
                  && request.resource.data.votes[request.auth.uid].vote in ['works', 'broken']
                  && request.resource.data.votes[request.auth.uid].at is string
                  && request.resource.data.votes[request.auth.uid].at.size() <= 40
                  && request.resource.data.votes[request.auth.uid].credibilitySnapshot is number
                  && request.resource.data.votes[request.auth.uid].credibilitySnapshot >= 0
                )
           );

      // Riapertura a pagamento dalla board (DC4): un utente LOGGATO scrive SOLO
      // la propria chiave nel map `reopenRequests` (stesso pattern di `votes`
      // sopra — chiave==uid, nessun altro campo toccabile). È solo il SEGNALE
      // "ho chiesto la riapertura": non tocca `status` (quello resta admin/
      // routine, vedi i rami sopra) — il flip fuori da "Risolti" lo applica il
      // percorso fidato leggendo questo campo. Entry: { at: <ISO> }.
      allow update: if
        request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reopenRequests'])
        && request.resource.data.get('reopenRequests', {}) is map
        && request.resource.data.get('reopenRequests', {})
             .diff(resource.data.get('reopenRequests', {})).affectedKeys()
             .hasOnly([request.auth.uid])
        && (
             !(request.auth.uid in request.resource.data.get('reopenRequests', {}))
             || (
                  request.resource.data.reopenRequests[request.auth.uid].keys()
                    .hasOnly(['at'])
                  && request.resource.data.reopenRequests[request.auth.uid].at is string
                  && request.resource.data.reopenRequests[request.auth.uid].at.size() <= 40
                )
           );

      // Triage routine (limitato): può solo muovere l'ITER DI LAVORAZIONE della
      // macchina a stati (todo/working/revision_*/done/design) e scrivere
      // `notes`/`resolvedAt`/`statusReason`/`workingSince`/`branch`. NON tocca
      // `priority`, NON archivia, NON conferma attacchi, NON cancella. Più
      // stretto del ramo admin di proposito: è il contenimento del blast radius
      // del ruolo routine. (`clarify` legacy resta per la transizione.)
      allow update: if
        isRoutine()
        && request.resource.data.diff(resource.data).affectedKeys()
          // `updatedAt` (#676): il server firma l'ora come chiunque altro, o
          // la dashboard non vede più quello che scrive fino al riallineamento.
          .hasOnly(['status', 'notes', 'resolvedAt', 'statusReason', 'workingSince', 'branch', 'livelli', 'updatedAt'])
        && request.resource.data.get('status', 'new') in
             ['todo', 'working', 'revision_capability', 'revision_security', 'done', 'design', 'clarify']
        && request.resource.data.get('statusReason', '') is string
        && request.resource.data.get('statusReason', '').size() <= 60
        && request.resource.data.get('workingSince', '') is string
        && request.resource.data.get('workingSince', '').size() <= 40
        && request.resource.data.get('branch', '') is string
        && request.resource.data.get('branch', '').size() <= 200
        // Stesso tetto del ramo admin (SN_FEEDBACK_THREAD.NOTES_MAX): i due
        // rami devono restare allineati, o una routine potrebbe scrivere note
        // che poi bloccano l'owner.
        && request.resource.data.get('notes', '') is string
        && request.resource.data.get('notes', '').size() <= 540000
        && (!('updatedAt' in request.resource.data)
            || request.resource.data.updatedAt is timestamp)
        && livelliValidi(request.resource.data);

      // Cancellazione: solo admin.
      allow delete: if isAdmin();
    }

    // ── La VISTA pubblica dei feedback (#583) ────────────────────────────────
    //
    // `feedback-public/{id}` è una PROIEZIONE del feedback con lo stesso id:
    // solo i campi che possono stare sotto gli occhi di chiunque, e solo per i
    // feedback CHIUSI e mai segnalati dalla sicurezza. È ciò che la bacheca
    // (filo://board/) mostra e ciò su cui il popup delle ricompense riconosce i
    // feedback di chi lo apre (per `clientIdTag`, un'impronta diversa su ogni
    // scheda: chi legge la bacheca non può raggruppare i fix per segnalatore).
    //
    // Perché una vista e non una regola più furba sulla collezione vera: le
    // regole di Firestore decidono SE un documento si legge, non QUALI campi
    // tornano. Finché la bacheca leggeva il documento intero e filtrava in
    // pagina, "filtrato" voleva dire solo "non disegnato": il testo, l'URL e le
    // note erano già arrivati sul computer di chi guardava.
    //
    // La scrive chi ha l'autorità di chiudere un feedback (owner o server) e
    // deve poter escludere ciò che va escluso: la decisione su cosa pubblicare
    // sta in src/shared/feedbackPublicView.js, che vede lo status VERO
    // (decifrato) e scarta tutto quello che ha passato le mani della sicurezza.
    // Le regole qui sotto sono la rete: elencano i campi ammessi, così un
    // giorno in cui quel codice sbaglia il testo di un feedback non finisce
    // comunque in una collezione pubblica.
    match /feedback-public/{doc} {
      allow read: if true;

      // Pubblicazione/aggiornamento della scheda: owner o server, e SOLO i
      // campi dell'elenco (`hasOnly`), che è la lista di ciò che è pubblico
      // per costruzione. `text`, `url`, `userAgent`, `images`, `files`,
      // `notes`, `clientId`, `pipeline`, `priority` non sono qui dentro: se
      // qualcuno provasse a scriverli, la regola respinge tutto il documento.
      // Un lavoro locale (#908) non ha scheda, ma qui NON si respinge: un'app
      // rimasta alla versione di prima si fermerebbe alla prima scheda rifiutata
      // e non pubblicherebbe più niente. La toglie il server (onPublicCardWrite).
      allow create, update: if (isAdmin() || isRoutine())
        && request.resource.data.keys().hasOnly(
             ['name', 'seq', 'subSeq', 'status', 'statusPublic', 'resolvedInVersion',
              'createdAt', 'resolvedAt', 'clientIdTag', 'userNote', 'reward',
              'publishedAt', 'votes', 'reopenRequests'])
        // `status` solo fra quelli CHIUSI: un feedback aperto (e a maggior
        // ragione uno fermato dalla sicurezza) non ha una scheda pubblica.
        && request.resource.data.get('status', 'done') in ['done', 'verified', 'archived', 'ignored']
        && request.resource.data.get('statusPublic', 'closed') in ['open', 'closed', 'pending-approval']
        && request.resource.data.get('name', '') is string
        && request.resource.data.get('name', '').size() <= 200
        // La frase per chi ha segnalato: è l'unico dei due testi in chiaro
        // (il report per l'owner viaggia cifrato e non entra qui), e il tetto
        // è lo stesso della collezione vera.
        && request.resource.data.get('userNote', '') is string
        && request.resource.data.get('userNote', '').size() <= 500
        && request.resource.data.get('resolvedInVersion', '') is string
        && request.resource.data.get('resolvedInVersion', '').size() <= 40
        // `clientIdTag` è l'impronta di QUESTA scheda per chi l'ha segnalata,
        // non dell'installazione: cambia da una scheda all'altra, quindi chi
        // legge la bacheca non può raggruppare i fix per segnalatore.
        // `clientIdHash` (uguale su tutte le sue schede) NON è ammesso qui.
        && request.resource.data.get('clientIdTag', '') is string
        && request.resource.data.get('clientIdTag', '').size() <= 64
        && request.resource.data.get('createdAt', '') is string
        && request.resource.data.get('createdAt', '').size() <= 40
        && request.resource.data.get('resolvedAt', '') is string
        && request.resource.data.get('resolvedAt', '').size() <= 40
        && request.resource.data.get('publishedAt', '') is string
        && request.resource.data.get('publishedAt', '').size() <= 40
        && request.resource.data.get('seq', 0) is int
        && request.resource.data.get('seq', 0) >= 0
        && request.resource.data.get('seq', 0) <= 1000000
        && request.resource.data.get('subSeq', 0) is int
        && request.resource.data.get('subSeq', 0) >= 0
        && request.resource.data.get('subSeq', 0) <= 100000
        // `reward`: i crediti che spettano a chi ha mandato il feedback. La sua
        // macchina non legge più i feedback veri, quindi la fascia la trova
        // qui. Il tetto è largo ma finito: una scheda non può promettere una
        // cifra arbitraria.
        && request.resource.data.get('reward', 0) is int
        && request.resource.data.get('reward', 0) >= 0
        && request.resource.data.get('reward', 0) <= 1000;

      // Voto della bacheca: stesso identico pattern della collezione vera —
      // un utente LOGGATO scrive SOLO la propria chiave nel map `votes`.
      // I voti vivono anche qui perché è qui che la bacheca li legge: il
      // documento vero non lo può più aprire.
      allow update: if
        request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes'])
        && request.resource.data.get('votes', {}) is map
        && request.resource.data.get('votes', {})
             .diff(resource.data.get('votes', {})).affectedKeys()
             .hasOnly([request.auth.uid])
        && (
             !(request.auth.uid in request.resource.data.get('votes', {}))
             || (
                  request.resource.data.votes[request.auth.uid].keys()
                    .hasOnly(['vote', 'at', 'credibilitySnapshot'])
                  && request.resource.data.votes[request.auth.uid].vote in ['works', 'broken']
                  && request.resource.data.votes[request.auth.uid].at is string
                  && request.resource.data.votes[request.auth.uid].at.size() <= 40
                  && request.resource.data.votes[request.auth.uid].credibilitySnapshot is number
                  && request.resource.data.votes[request.auth.uid].credibilitySnapshot >= 0
                )
           );

      // Riapertura a pagamento: stesso pattern, sul map `reopenRequests`. È il
      // segnale che fa USCIRE la scheda dalla bacheca (DC4).
      allow update: if
        request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reopenRequests'])
        && request.resource.data.get('reopenRequests', {}) is map
        && request.resource.data.get('reopenRequests', {})
             .diff(resource.data.get('reopenRequests', {})).affectedKeys()
             .hasOnly([request.auth.uid])
        && (
             !(request.auth.uid in request.resource.data.get('reopenRequests', {}))
             || (
                  request.resource.data.reopenRequests[request.auth.uid].keys()
                    .hasOnly(['at'])
                  && request.resource.data.reopenRequests[request.auth.uid].at is string
                  && request.resource.data.reopenRequests[request.auth.uid].at.size() <= 40
                )
           );

      // Spubblicazione: owner o server. Un fix che torna in lavorazione esce
      // dalla bacheca togliendo la sua scheda, non nascondendola in pagina.
      allow delete: if isAdmin() || isRoutine();
    }

    // ── Il contatore dei numeri dei feedback (#583) ──────────────────────────
    //
    // `counters/feedbackSeq` tiene il numero progressivo (#583, #584…). Prima
    // lo si ricavava con una query sulla collezione feedback ordinata per
    // `seq`: una LETTURA, e l'invio di un feedback è anonimo per scelta. Con la
    // lettura chiusa quella strada non c'è più, e senza numero un feedback
    // nuovo arriverebbe senza il suo nome in dashboard e nelle routine.
    //
    // Qui dentro c'è un intero e niente altro: quanti feedback sono arrivati.
    // Chiunque può farlo avanzare DI UNO — è ciò che fa chi invia — e nessuno
    // può farlo tornare indietro o riempirlo d'altro. Il caso peggiore è un
    // numero saltato, che è un'etichetta, non una chiave; l'owner può
    // rimetterlo in pari (ramo admin) e la dashboard lo fa da sola quando vede
    // un `seq` più alto del contatore.
    match /counters/{name} {
      allow read: if true;
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['value'])
        && request.resource.data.value is int
        && request.resource.data.value >= 0;
      allow update: if isAdmin()
        && request.resource.data.keys().hasOnly(['value'])
        && request.resource.data.value is int
        && request.resource.data.value >= 0;
      allow update: if request.resource.data.keys().hasOnly(['value'])
        && request.resource.data.value is int
        && request.resource.data.value == resource.data.value + 1
        && request.resource.data.value <= 1000000;
      allow delete: if false;
    }

    // Crediti (gamification): un documento per utente, ID = uid Firebase.
    // Ogni utente legge/scrive SOLO il proprio doc. È client-authoritative:
    // l'app desktop calcola saldo/consumo nel main e sincronizza qui. In alpha
    // accettiamo il caveat (un utente potrebbe gonfiarsi i crediti manomettendo
    // il client): i crediti non danno accesso a risorse altrui né a dati di
    // altri utenti, quindi il blast radius è solo "barare col proprio saldo".
    // Se in futuro i crediti diventano spendibili per davvero, va spostato il
    // calcolo su una Cloud Function autorevole.
    // Oltre al proprietario, anche un ADMIN può leggere e scrivere qualsiasi
    // doc credits: serve ai comandi proprietario /users (elenco utenti) e /gift
    // (accredito crediti a un altro account). L'app desktop sincronizza qui
    // anche `email`/`name` dell'utente, così l'admin può risolvere email→uid e
    // listare gli iscritti. Resta client-authoritative per il saldo proprio.
    match /credits/{uid} {
      allow read, write: if request.auth != null
        && request.auth.uid == uid;
      allow read, write: if isAdmin();
    }

    // ── Crediti sul server e chiave OpenRouter personale (#598) ──────────────
    //
    // Il saldo NON lo scrive più il client: è il tetto di spesa della chiave
    // OpenRouter personale meno il consumo, e lo legge il server. Qui il
    // client può solo LEGGERE il proprio portafoglio e i propri inviti, e
    // AGGIUNGERE righe al registro d'uso per il proprio pseudonimo. Tutto il
    // resto lo scrive il server (Admin SDK, che bypassa queste regole).
    //
    // L'identità è quella dell'INSTALLAZIONE: un account Firebase anonimo per
    // copia di Filo (request.auth c'è anche senza login Google).

    // Il portafoglio: pseudonimo, hash della chiave, tetto, consumo letto,
    // crediti elargiti, chi ha invitato. Legge il proprietario (e l'admin).
    match /wallet-accounts/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow read: if isAdmin();
      allow write: if false;
    }

    // Un codice d'invito. Legge chi lo possiede (per mostrarlo e sapere se è
    // stato usato). Il riscatto passa dal server.
    match /wallet-invites/{code} {
      allow read: if request.auth != null && resource.data.ownerUid == request.auth.uid;
      allow read: if isAdmin();
      allow write: if false;
    }

    // Il registro d'uso: una riga per chiamata ai modelli fatta con la chiave
    // personale. SOLA AGGIUNTA, e solo per il proprio pseudonimo: lo
    // pseudonimo della riga deve essere quello scritto dal server nel
    // portafoglio di chi scrive (chi non ha un portafoglio non scrive). Campi
    // fissi (hasOnly): sono gli stessi di src/shared/wallet.js USAGE_FIELDS.
    // Nessuna modifica né cancellazione: il server confronta ogni ora la somma
    // delle righe col consumo che OpenRouter dichiara per la chiave.
    match /wallet-usage/{id} {
      allow read: if isAdmin();
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['pseudonym', 'at', 'action', 'model', 'servedBy',
             'promptTokens', 'completionTokens', 'costUsd', 'credits'])
        && request.resource.data.pseudonym is string
        && request.resource.data.pseudonym.size() == 16
        && request.resource.data.pseudonym
             == get(/databases/$(database)/documents/wallet-accounts/$(request.auth.uid)).data.pseudonym
        && request.resource.data.at is string && request.resource.data.at.size() <= 40
        && request.resource.data.action is string && request.resource.data.action.size() <= 80
        && request.resource.data.model is string && request.resource.data.model.size() <= 200
        && request.resource.data.servedBy is string && request.resource.data.servedBy.size() <= 100
        && request.resource.data.promptTokens is number
        && request.resource.data.completionTokens is number
        && request.resource.data.costUsd is number
        && request.resource.data.credits is number;
      allow update, delete: if false;
    }

    // Stato delle funzioni programmate (giornaliera, riconciliazione): solo
    // il server scrive, l'admin legge.
    match /wallet-state/{doc} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // I riscatti riusciti per rete (#1120), per impronta: li legge e scrive
    // solo il server. Nessun client, nemmeno l'admin: un'impronta non dice
    // niente a chi guarda, e un contatore scritto da fuori aprirebbe il tetto.
    match /wallet-redeem-nets/{hash} {
      allow read, write: if false;
    }

    // A quale portafoglio un account Google (impronta) ha dato il suo giro di codici (#1120): solo il server. Scritto da
    // fuori, sposterebbe i codici da un portafoglio all'altro.
    match /wallet-google-invites/{hash} {
      allow read, write: if false;
    }

    // ── I contatori anonimi (#969, #1461, #1466) ─────────────────────────────
    //
    // Numeri senza contenuto: per funzione quante volte è stata usata e quanto si è aspettato (in fasce), i guasti
    // delle chiamate, e (#1461) l'attesa delle azioni, le impostazioni cambiate, le ricerche nei pannelli, le
    // proposte del correttore, le conferme di Filo, gli annulli, gli anticipi, gli errori visti, l'intervista e le
    // prime volte del mese; (#1466, ore v3) i passi dell'avvio, i processi morti, i blocchi, le eccezioni del main, la
    // memoria, le chiamate sincrone, la chiusura, il disco, la sessione e gli aggiornamenti, tutti in elenchi chiusi.
    // Un documento per copia di Filo e per ora (v3; le ore v2 e i giorni v1 partono ancora dalle copie vecchie):
    // l'id è pseudonimo, giorno e ora, e si scrive una volta sola (create, mai update). Lo pseudonimo è
    // casuale, cambia ogni mese, e non è il codice dei feedback né lo pseudonimo dei crediti.
    //
    // SOLA CREAZIONE E SENZA LOGIN, come i feedback: chi ha la chiave web può scrivere numeri falsi, e i contatori
    // servono a leggere tendenze, non a dare niente a nessuno. Qui si tiene la forma: i campi, i tipi, e i valori
    // annidati, ognuno una stringa di forma fissa (le regole non passano in rassegna una mappa, ma ne uniscono chiavi
    // e valori in una stringa sola, che si misura e si confronta). Le chiavi degli elenchi piccoli e fermi (funzioni,
    // pannelli, tipi del correttore) sono l'elenco; quelle degli elenchi che crescono a ogni funzione nuova (azioni,
    // impostazioni, tipi d'azione, errori) ne hanno la forma, senza spazi né testo: l'elenco chiuso lo tiene l'app.
    // tests/unit/firestoreRulesContatori.test.mjs confronta tutto con l'app: una funzione nuova va aggiunta e
    // ripubblicata, o le ore che la portano restano in attesa; una tolta dall'app RESTA, le copie vecchie la mandano.
    // Legge solo l'admin.
    // Le funzioni contate e il controllo delle mappe a chiavi chiuse servono alle ore e alle loro chiamate.
    function funzioniContate() {
      return [
        'explain', 'explain-deep', 'explain-link', 'translate-selection', 'translate-page', 'edit-text',
        'categorize', 'describe-image', 'transcribe-image', 'spellcheck-word', 'spellcheck-semantic', 'spellcheck-context',
        'transcribe-audio', 'tts', 'help', 'help-intent-guess', 'help-intent-judge', 'filo-chat', 'filo-dashboard',
        'filo-lesson', 'filo-compact', 'filo-chat-triage', 'tab-triage', 'tab-summary', 'archive-embed',
        'tab-search', 'editor-title', 'editor-summary', 'editor-chat', 'file-name', 'decks-chat', 'decks-opinion',
        'decks-autotag', 'decks-search-filter', 'safebrowse-judge', 'geoblock-classify', 'embed-cookie-check',
        'feedback-title', 'manage-search', 'manage-search-classify', 'provider-test'
      ];
    }
    function chiuse(m, chiavi, tetto, valori) {
      return m is map && m.keys().hasOnly(chiavi)
        && m.values().join('#').size() <= tetto && m.values().join('#').matches(valori);
    }
    match /contatori-giornalieri/{docId} {
      function contatoriGiorno(d) {
        return d.keys().hasOnly(['v', 'pseudonimo', 'giorno', 'mese', 'app', 'os', 'uso', 'errori'])
          && d.keys().hasAll(['v', 'pseudonimo', 'giorno', 'mese', 'app', 'os', 'uso', 'errori'])
          && d.v == 1
          && d.pseudonimo is string && d.pseudonimo.matches('^[0-9a-f]{20}$')
          && d.giorno is string && d.giorno.matches('^20[0-9]{2}-[01][0-9]-[0-3][0-9]$')
          && d.mese is string && d.mese.matches('^20[0-9]{2}-[01][0-9]$')
          && d.giorno.matches(d.mese + '-[0-3][0-9]')
          && docId == d.pseudonimo + '_' + d.giorno
          && d.app is string && d.app.matches('^[0-9]{1,4}[.][0-9]{1,4}[.][0-9]{1,6}$')
          && d.os in ['win', 'mac', 'linux', 'altro']
          && d.uso is map && d.uso.keys().hasOnly(funzioniContate())
          && d.uso.values().join('#').size() <= 8000
          && d.uso.values().join('#').matches('^([0-9]{1,9};[0-9]{1,9}(,[0-9]{1,9}){6}(#[0-9]{1,9};[0-9]{1,9}(,[0-9]{1,9}){6})*)?$')
          && d.errori is map && d.errori.keys().hasOnly(funzioniContate())
          && d.errori.values().join('#').size() <= 600000
          && d.errori.values().join('#').matches('^([a-z0-9._:/-]{1,120}[|][A-Za-z0-9 ._-]{0,48}[|](rete|tempo|crediti|chiave|nessun_host|fornitore)[|][0-9]{1,9}(;[a-z0-9._:/-]{1,120}[|][A-Za-z0-9 ._-]{0,48}[|](rete|tempo|crediti|chiave|nessun_host|fornitore)[|][0-9]{1,9})*(#[a-z0-9._:/-]{1,120}[|][A-Za-z0-9 ._-]{0,48}[|](rete|tempo|crediti|chiave|nessun_host|fornitore)[|][0-9]{1,9}(;[a-z0-9._:/-]{1,120}[|][A-Za-z0-9 ._-]{0,48}[|](rete|tempo|crediti|chiave|nessun_host|fornitore)[|][0-9]{1,9})*)*)?$');
      }
      function aForma(m, chiavi, tettoChiavi, tetto, valori) {
        return m is map && m.keys().join('#').size() <= tettoChiavi && m.keys().join('#').matches(chiavi)
          && m.values().join('#').size() <= tetto && m.values().join('#').matches(valori);
      }
      // Pseudonimo, giorno, ora, versione, sistema e segno del primo documento: uguali per le ore v2 e v3.
      function testaOra(d) {
        return d.pseudonimo is string && d.pseudonimo.matches('^[0-9a-f]{20}$')
          && d.giorno is string && d.giorno.matches('^20[0-9]{2}-[01][0-9]-[0-3][0-9]$')
          && d.mese is string && d.mese.matches('^20[0-9]{2}-[01][0-9]$')
          && d.giorno.matches(d.mese + '-[0-3][0-9]')
          && d.ora is string && d.ora.matches('^([01][0-9]|2[0-3])$')
          && docId == d.pseudonimo + '_' + d.giorno + '_' + d.ora
          && d.app is string && d.app.matches('^[0-9]{1,4}[.][0-9]{1,4}[.][0-9]{1,6}$')
          && d.os in ['win', 'mac', 'linux', 'altro']
          && d.primo in ['', 'giorno', 'mese'];
      }
      // Le misure dell'ora di #1461, uguali per le ore v2 e v3.
      function misureOra(d) {
        let funzioni = funzioniContate();
        return chiuse(d.uso, funzioni, 15000, '^([0-9]{1,9};[0-9]{1,9}(,[0-9]{1,9}){6};[0-9]{1,9}(,[0-9]{1,9}){6};[0-9]{1,9}(#[0-9]{1,9};[0-9]{1,9}(,[0-9]{1,9}){6};[0-9]{1,9}(,[0-9]{1,9}){6};[0-9]{1,9})*)?$')
          && chiuse(d.errori, funzioni, 300000, '^([a-z0-9._:/-]{1,120}[|][A-Za-z0-9 ._-]{0,48}[|](rete|tempo|crediti|chiave|nessun_host|fornitore)[|][0-9]{1,9}(;[a-z0-9._:/-]{1,120}[|][A-Za-z0-9 ._-]{0,48}[|](rete|tempo|crediti|chiave|nessun_host|fornitore)[|][0-9]{1,9})*(#[a-z0-9._:/-]{1,120}[|][A-Za-z0-9 ._-]{0,48}[|](rete|tempo|crediti|chiave|nessun_host|fornitore)[|][0-9]{1,9}(;[a-z0-9._:/-]{1,120}[|][A-Za-z0-9 ._-]{0,48}[|](rete|tempo|crediti|chiave|nessun_host|fornitore)[|][0-9]{1,9})*)*)?$')
          && aForma(d.azioni, '^([a-z0-9][a-z0-9-]{0,59}(#[a-z0-9][a-z0-9-]{0,59})*)?$', 15000, 40000, '^([0-9]{1,9};[0-9]{1,9}(,[0-9]{1,9}){6};[0-9]{1,9}(,[0-9]{1,9}){6};[0-9]{1,9}(#[0-9]{1,9};[0-9]{1,9}(,[0-9]{1,9}){6};[0-9]{1,9}(,[0-9]{1,9}){6};[0-9]{1,9})*)?$')
          && aForma(d.impostazioni, '^([A-Za-z0-9_.*-]{1,80}(#[A-Za-z0-9_.*-]{1,80})*)?$', 15000, 100000, '^([A-Za-z0-9_.-]{1,40}[|](mano|chat|auto|import)[|][0-9]{1,9}(;[A-Za-z0-9_.-]{1,40}[|](mano|chat|auto|import)[|][0-9]{1,9})*(#[A-Za-z0-9_.-]{1,40}[|](mano|chat|auto|import)[|][0-9]{1,9}(;[A-Za-z0-9_.-]{1,40}[|](mano|chat|auto|import)[|][0-9]{1,9})*)*)?$')
          && chiuse(d.ricerche, ['cerca-filo', 'incolla', 'font', 'modello', 'barra-laterale', 'tasto-destro', 'menu'], 4000, '^([0-9]{1,9};[0-9]{1,9}(,[0-9]{1,9}){6};[0-9]{1,9}(,[0-9]{1,9}){5};[0-9]{1,9}(#[0-9]{1,9};[0-9]{1,9}(,[0-9]{1,9}){6};[0-9]{1,9}(,[0-9]{1,9}){5};[0-9]{1,9})*)?$')
          && chiuse(d.correttore, ['ortografia', 'frase', 'coerenza', 'suggerimento'], 40000, '^([a-z0-9._:/-]{1,120}[|][0-9]{1,9},[0-9]{1,9},[0-9]{1,9},[0-9]{1,9}(;[a-z0-9._:/-]{1,120}[|][0-9]{1,9},[0-9]{1,9},[0-9]{1,9},[0-9]{1,9})*(#[a-z0-9._:/-]{1,120}[|][0-9]{1,9},[0-9]{1,9},[0-9]{1,9},[0-9]{1,9}(;[a-z0-9._:/-]{1,120}[|][0-9]{1,9},[0-9]{1,9},[0-9]{1,9},[0-9]{1,9})*)*)?$')
          && aForma(d.conferme, '^([A-Za-z][A-Za-z0-9_-]{0,39}(#[A-Za-z][A-Za-z0-9_-]{0,39})*)?$', 4000, 100000, '^((conservativo|default|automatico|yolo|altro)[|](pulito|contaminato|altro)[|](0|1|2|3|altro)[|](dentro|fuori|altro)[|](chat|automazione|altro)[|](si|chiede|conferma|no|propone|altro)[|](automatica|approvata|rifiutata|senza-risposta|negata|pannello)[|][0-9]{1,9}(;(conservativo|default|automatico|yolo|altro)[|](pulito|contaminato|altro)[|](0|1|2|3|altro)[|](dentro|fuori|altro)[|](chat|automazione|altro)[|](si|chiede|conferma|no|propone|altro)[|](automatica|approvata|rifiutata|senza-risposta|negata|pannello)[|][0-9]{1,9})*(#(conservativo|default|automatico|yolo|altro)[|](pulito|contaminato|altro)[|](0|1|2|3|altro)[|](dentro|fuori|altro)[|](chat|automazione|altro)[|](si|chiede|conferma|no|propone|altro)[|](automatica|approvata|rifiutata|senza-risposta|negata|pannello)[|][0-9]{1,9}(;(conservativo|default|automatico|yolo|altro)[|](pulito|contaminato|altro)[|](0|1|2|3|altro)[|](dentro|fuori|altro)[|](chat|automazione|altro)[|](si|chiede|conferma|no|propone|altro)[|](automatica|approvata|rifiutata|senza-risposta|negata|pannello)[|][0-9]{1,9})*)*)?$')
          && aForma(d.annullati, '^([A-Za-z][A-Za-z0-9_-]{0,39}(#[A-Za-z][A-Za-z0-9_-]{0,39})*)?$', 4000, 2000, '^([0-9]{1,9}(#[0-9]{1,9})*)?$')
          && chiuse(d.anticipi, funzioni, 2000, '^([0-9]{1,9};[0-9]{1,9}(#[0-9]{1,9};[0-9]{1,9})*)?$')
          && chiuse(d.chiedi, funzioni, 1000, '^([0-9]{1,9}(#[0-9]{1,9})*)?$')
          && aForma(d.erroriVisti, '^([a-z0-9_:.-]{1,80}(#[a-z0-9_:.-]{1,80})*)?$', 10000, 8000, '^([0-9]{1,9}(#[0-9]{1,9})*)?$')
          && aForma(d.intervista, '^([a-z0-9_-]{1,30}(#[a-z0-9_-]{1,30})*)?$', 1000, 8000, '^([a-z0-9_-]{1,30}[|][0-9]{1,9}(;[a-z0-9_-]{1,30}[|][0-9]{1,9})*(#[a-z0-9_-]{1,30}[|][0-9]{1,9}(;[a-z0-9_-]{1,30}[|][0-9]{1,9})*)*)?$')
          && d.primeVolte is list && d.primeVolte.size() <= 400
          && d.primeVolte.join('#').size() <= 30000 && d.primeVolte.join('#').matches('^([a-z0-9][a-z0-9-]{0,59}(#[a-z0-9][a-z0-9-]{0,59})*)?$');
      }
      // Le ore delle copie che non hanno ancora le misure del sistema (fino alla 0.2.248).
      function contatoriOra(d) {
        return d.keys().hasOnly(['v', 'pseudonimo', 'giorno', 'mese', 'ora', 'app', 'os', 'primo', 'uso', 'errori', 'azioni', 'impostazioni', 'ricerche', 'correttore', 'conferme', 'annullati', 'anticipi', 'chiedi', 'erroriVisti', 'intervista', 'primeVolte'])
          && d.keys().hasAll(['v', 'pseudonimo', 'giorno', 'mese', 'ora', 'app', 'os', 'primo', 'uso', 'errori', 'azioni', 'impostazioni', 'ricerche', 'correttore', 'conferme', 'annullati', 'anticipi', 'chiedi', 'erroriVisti', 'intervista', 'primeVolte'])
          && d.v == 2
          && testaOra(d) && misureOra(d);
      }
      // Le ore v3 (#1466): quelle di prima più il sistema in un campo solo, una stringa di voci da elenchi chiusi
      // (avvio, processi morti, blocchi, eccezioni del main, memoria, chiamate sincrone, chiusura, disco, sessione,
      // aggiornamenti). Controllato qui e non in una funzione: ogni uso di un argomento si rivaluta, e costa.
      function contatoriOra3(d) {
        let campi = ['v', 'pseudonimo', 'giorno', 'mese', 'ora', 'app', 'os', 'primo', 'uso', 'errori', 'azioni', 'impostazioni', 'ricerche', 'correttore', 'conferme', 'annullati', 'anticipi', 'chiedi', 'erroriVisti', 'intervista', 'primeVolte', 'sistema'];
        return d.keys().hasOnly(campi)
          && d.keys().hasAll(campi)
          && d.v == 3
          && testaOra(d) && misureOra(d)
          && d.sistema is string && d.sistema.size() <= 16000
          && d.sistema.matches('^((^|;)(avvioPasso[.](impostazioni_lette|protocollo_ipc|adblock|fingerprint|permessi|finestra_creata|prima_scheda_visibile|sessione_ripristinata)[.](ms500|s1|s2|s5|s10|s30|oltre)|avvioTipo[.](freddo|dopo_aggiornamento|seconda_istanza)|processoMorto[.](gpu|utility|zygote|sandbox_helper|pepper_plugin|scheda_in_recupero|altro)[.](abnormal-exit|killed|crashed|oom|launch-failed|integrity-failure|memory-eviction|altro)|finestraBloccata[.]((volte)|(tornata)[.](ms500|s1|s2|s5|s10|s30|oltre)|(chiusa_da_utente)[.](ms500|s1|s2|s5|s10|s30|oltre))|mainFermo[.]((max)[.](ms500|s1|s2|s5|s10|s30|oltre)|(blocchi)[.](ms200|ms1000|ms5000))|eccezioneMain[.](uncaught|rejection)[.](TypeError|RangeError|ReferenceError|SyntaxError|Error|altro)|memoria[.]((totale)[.](mb256|mb512|mb1024|mb2048|mb4096|oltre)|(vive)[.](n0|n1|n5|n20|n50|oltre)|(attesa)[.](n0|n1|n5|n20|n50|oltre))|ipcSincrono[.](fp-config|cookie-wipe|adblock-css|permessi-stato)[.](ms500|s1|s2|s5|s10|s30|oltre)|chiusura[.]((durata)[.](ms500|s1|s2|s5|s10|s30|oltre)|(tetto))|uscitaPrecedente[.](pulita|non_pulita)|storageEsito[.](lettura_ok|lettura_vuoto|lettura_illeggibile|lettura_rovinato_con_copia|lettura_rovinato_senza_copia|lettura_non_spostato_sola_memoria|salvataggio_fallito_enospc|salvataggio_fallito_eacces|salvataggio_fallito_eperm|salvataggio_fallito_erofs|salvataggio_fallito_ebusy|salvataggio_fallito_altro|salvataggio_tornato|rinomina_ritentata_ebusy|rinomina_ritentata_eperm|rinomina_ritentata_eacces|chiave_non_serializzabile|cambiato_senza_set|cifratura_assente|dimensione_mb1|dimensione_mb5|dimensione_mb20|dimensione_mb50|dimensione_mb100|dimensione_oltre|flush_ms500|flush_s1|flush_s2|flush_s5|flush_s10|flush_s30|flush_oltre)|sessione[.]((schede)[.](n0|n1|n5|n20|n50|oltre)|(esiti)[.](ripristinata|niente|lettura_fallita)|(vista)[.](ms500|s1|s2|s5|s10|s30|oltre)|(coda)[.](ms500|s1|s2|s5|s10|s30|oltre))|aggiornamento[.](trovato|scaricato|scaricamento_fallito|installatore_non_valido|installazione_lanciata_all_avvio|installazione_fallita|installazione_fallita_secondo_avviso|versione_rifiutata|bloccato_mac|bloccato_linux|installatore_non_avviato))[|][0-9]{1,9})*$');
      }
      // La forma si sceglie dalla versione prima di provarla: il server valuta al più mille espressioni a richiesta (ogni
      // uso di un argomento si rivaluta, ogni elemento di un elenco conta), e un'ora v3 provata dopo le altre ci passerebbe
      // sopra. Il margine lo misura solo il motore vero: tests/unit/contatoriRegole.motore-vero.mjs.
      function contatori(d) {
        return (d.v == 3 && contatoriOra3(d)) || (d.v == 2 && contatoriOra(d)) || (d.v == 1 && contatoriGiorno(d));
      }
      allow get, list: if isAdmin();
      allow create: if contatori(request.resource.data);
      allow update, delete: if false;
    }

    // ── Le chiamate ai modelli dei contatori (#1464) ─────────────────────────
    //
    // Per ogni ora di contatori che ne ha, i numeri delle chiamate ai modelli: per funzione e modello il contesto, la
    // cache, il ragionamento, l'uscita, i ripieghi, la spesa e gli adattamenti, in fasce; le chiamate per uso. Stesso
    // pseudonimo, stessa ora e stesso id dell'ora; sta in un documento a parte perché le regole dell'ora sono già
    // vicine al tetto di mille espressioni che Firestore valuta per scrittura. Le stesse regole dell'ora: sola
    // creazione, senza login, forma fissa, legge solo l'admin. Sentinella: tests/unit/firestoreRulesContatori.test.mjs.
    match /contatori-chiamate/{docId} {
      function contatoriChiamate(d) {
        let f = funzioniContate();
        return d.keys().hasOnly(['v', 'pseudonimo', 'giorno', 'mese', 'ora', 'app', 'os', 'contesto', 'cache', 'ragionamento', 'uscita', 'ripieghi', 'spesa', 'adattamenti', 'chiamate'])
          && d.keys().hasAll(['v', 'pseudonimo', 'giorno', 'mese', 'ora', 'app', 'os', 'contesto', 'cache', 'ragionamento', 'uscita', 'ripieghi', 'spesa', 'adattamenti', 'chiamate'])
          && d.v == 1
          && d.pseudonimo is string && d.pseudonimo.matches('^[0-9a-f]{20}$')
          && d.giorno is string && d.giorno.matches('^20[0-9]{2}-[01][0-9]-[0-3][0-9]$')
          && d.mese is string && d.mese.matches('^20[0-9]{2}-[01][0-9]$')
          && d.giorno.matches(d.mese + '-[0-3][0-9]')
          && d.ora is string && d.ora.matches('^([01][0-9]|2[0-3])$')
          && docId == d.pseudonimo + '_' + d.giorno + '_' + d.ora
          && d.app is string && d.app.matches('^[0-9]{1,4}[.][0-9]{1,4}[.][0-9]{1,6}$')
          && d.os in ['win', 'mac', 'linux', 'altro']
          && chiuse(d.contesto, f, 24000, '^([a-z0-9._:/-]{1,120}[|](t2k|t8k|t16k|t32k|t64k|t128k|oltre)[|][0-9]{1,9}(;[a-z0-9._:/-]{1,120}[|](t2k|t8k|t16k|t32k|t64k|t128k|oltre)[|][0-9]{1,9})*(#[a-z0-9._:/-]{1,120}[|](t2k|t8k|t16k|t32k|t64k|t128k|oltre)[|][0-9]{1,9}(;[a-z0-9._:/-]{1,120}[|](t2k|t8k|t16k|t32k|t64k|t128k|oltre)[|][0-9]{1,9})*)*)?$')
          && chiuse(d.cache, f, 22000, '^([a-z0-9._:/-]{1,120}[|](zero|q25|q50|q75|q100|nd)[|][0-9]{1,9}(;[a-z0-9._:/-]{1,120}[|](zero|q25|q50|q75|q100|nd)[|][0-9]{1,9})*(#[a-z0-9._:/-]{1,120}[|](zero|q25|q50|q75|q100|nd)[|][0-9]{1,9}(;[a-z0-9._:/-]{1,120}[|](zero|q25|q50|q75|q100|nd)[|][0-9]{1,9})*)*)?$')
          && chiuse(d.ragionamento, f, 22000, '^([a-z0-9._:/-]{1,120}[|](r0|r1k|r4k|r16k|oltre|nd)[|][0-9]{1,9}(;[a-z0-9._:/-]{1,120}[|](r0|r1k|r4k|r16k|oltre|nd)[|][0-9]{1,9})*(#[a-z0-9._:/-]{1,120}[|](r0|r1k|r4k|r16k|oltre|nd)[|][0-9]{1,9}(;[a-z0-9._:/-]{1,120}[|](r0|r1k|r4k|r16k|oltre|nd)[|][0-9]{1,9})*)*)?$')
          && chiuse(d.uscita, f, 64000, '^([a-z0-9._:/-]{1,120}[|](o256|o1k|o4k|o16k|oltre)[|](stop|length|tool_calls|filtro|altro)[|][0-9]{1,9}(;[a-z0-9._:/-]{1,120}[|](o256|o1k|o4k|o16k|oltre)[|](stop|length|tool_calls|filtro|altro)[|][0-9]{1,9})*(#[a-z0-9._:/-]{1,120}[|](o256|o1k|o4k|o16k|oltre)[|](stop|length|tool_calls|filtro|altro)[|][0-9]{1,9}(;[a-z0-9._:/-]{1,120}[|](o256|o1k|o4k|o16k|oltre)[|](stop|length|tool_calls|filtro|altro)[|][0-9]{1,9})*)*)?$')
          && chiuse(d.ripieghi, f, 28000, '^([a-z0-9._:/-]{1,120}[|](t1|t2|t3|t4_oltre)[|](si|no)[|][0-9]{1,9}(;[a-z0-9._:/-]{1,120}[|](t1|t2|t3|t4_oltre)[|](si|no)[|][0-9]{1,9})*(#[a-z0-9._:/-]{1,120}[|](t1|t2|t3|t4_oltre)[|](si|no)[|][0-9]{1,9}(;[a-z0-9._:/-]{1,120}[|](t1|t2|t3|t4_oltre)[|](si|no)[|][0-9]{1,9})*)*)?$')
          && chiuse(d.spesa, f, 18000, '^([a-z0-9._:/-]{1,120}[|](router|stima|tardiva)[|][0-9]{1,9}(;[a-z0-9._:/-]{1,120}[|](router|stima|tardiva)[|][0-9]{1,9})*(#[a-z0-9._:/-]{1,120}[|](router|stima|tardiva)[|][0-9]{1,9}(;[a-z0-9._:/-]{1,120}[|](router|stima|tardiva)[|][0-9]{1,9})*)*)?$')
          && chiuse(d.adattamenti, f, 20000, '^([a-z0-9._:/-]{1,120}[|](contesto_stretto|finestra_piccola|ragionamento_tolto)[|][0-9]{1,9}(;[a-z0-9._:/-]{1,120}[|](contesto_stretto|finestra_piccola|ragionamento_tolto)[|][0-9]{1,9})*(#[a-z0-9._:/-]{1,120}[|](contesto_stretto|finestra_piccola|ragionamento_tolto)[|][0-9]{1,9}(;[a-z0-9._:/-]{1,120}[|](contesto_stretto|finestra_piccola|ragionamento_tolto)[|][0-9]{1,9})*)*)?$')
          && chiuse(d.chiamate, f, 5000, '^([0-9]{1,9}(,[0-9]{1,9}){4}(#[0-9]{1,9}(,[0-9]{1,9}){4})*)?$');
      }
      allow get, list: if isAdmin();
      allow create: if contatoriChiamate(request.resource.data);
      allow update, delete: if false;
    }

    // Le manopole dei crediti (euro per credito, ingresso, quota, inviti
    // rimasti, tetto globale) più cambio e somma dei tetti scritti dal server.
    // Campi non enumerati, come gli altri config/*: aggiungerne uno non
    // richiede un redeploy delle regole.
    match /config/credits {
      allow read, write: if isAdmin();
    }

    // Percorsi di navigazione raccolti dalla sidebar "Aiuto" (Fase 2).
    // Tupla anonima (sito, posizione iniziale, intento, azioni, esito) usata
    // per insegnare globalmente all'AI come muoversi su un dominio.
    //
    // SERVER-AUTHORITATIVE dal #585 (audit pre-alpha). È l'unica collezione che
    // attraversa il confine fra utenti: quello che uno scrive qui finisce nel
    // messaggio di sistema dell'agente Aiuto di un ALTRO, presentato come
    // percorso già riuscito. Finché il create chiedeva solo dei vincoli di
    // forma, con la chiave web del repo pubblico chiunque depositava un
    // "percorso" per il dominio che voleva, saltando i due LLM che nell'app
    // ripuliscono i percorsi prima di salvarli — e le regole non hanno modo di
    // provare che quei due LLM siano passati: girano sulla macchina di chi
    // naviga.
    //
    // Quindi il client NON scrive più: invia alla callable `pathSubmit` di
    // filo-security, che riapplica la pulizia condivisa
    // (src/shared/pathsSafety.js → sanitizeSubmission), tiene i limiti di
    // frequenza per identità e scrive con l'Admin SDK, che bypassa queste
    // regole. Il mittente resta anonimo: a cambiare è la strada, non il login.
    //
    // La lettura resta aperta a chiunque — serve all'Aiuto di chiunque, anche
    // sloggato — ma UN DOMINIO ALLA VOLTA, e quello che si legge qui è
    // CONTENUTO ESTERNO: chi lo mette in un prompt lo incapsula e lo dichiara
    // dati, mai ordini (src/shared/pathsSafety.js → formatKnownPathsForPrompt,
    // e il blocco "Percorsi condivisi" del prompt Aiuto in
    // src/shared/constants.js).
    //
    // IL DOMINIO È UN SEGMENTO DEL PERCORSO (audit pre-alpha, #584). Prima i
    // documenti stavano tutti in `paths/{doc}` con `allow read: if true`: con
    // la chiave web — che sta nel repo pubblico ed è pubblica per design — una
    // sola query scaricava la collezione INTERA, e in ogni documento c'era un
    // `clientId` in chiaro. Da lì si ricucivano i percorsi della stessa persona
    // su domini diversi: il profilo di navigazione che tutto il resto dell'app
    // si sforza di non far uscire. Chiudere la scrittura (#585) non tocca
    // quella porta: si entrava in lettura.
    //
    // Ora i percorsi stanno in `paths/<dominio>/entries`: si chiede un dominio
    // alla volta e si riceve solo quello. L'elenco completo non è più un
    // oggetto leggibile, e questo poggia su TRE cose insieme — toccarne una
    // sola riapre la porta:
    //   1. `paths/{domain}` (dove stanno anche i vecchi documenti piatti) è
    //      chiuso in lettura: né i documenti di prima, né l'elenco dei domini
    //      raccolti (che da solo direbbe chi frequenta cosa);
    //   2. `entries` si legge solo sotto un dominio NOMINATO;
    //   3. una collection group query su `entries` è negata perché in questo
    //      file non esiste nessun match ricorsivo `/{p=**}/entries/{doc}`:
    //      senza quello il motore rifiuta le query di gruppo. Aggiungerlo
    //      significherebbe rimettere in piedi il download dell'intera raccolta.
    //
    // E il documento non porta NULLA del mittente: niente `clientId`, niente
    // `userAgent` — per riusare un percorso non serve sapere chi l'ha fatto.
    //
    // L'OROLOGIO NON LO CHIUDONO QUESTE REGOLE, e vale la pena saperlo qui.
    // Su ogni documento Firestore scrive da sé `createTime`, al microsecondo, e
    // lo rimanda a chiunque legga: non c'è regola che lo tolga. Finché un
    // percorso partiva nell'istante in cui veniva fatto, due percorsi su domini
    // diversi nati a meno di un secondo l'uno dall'altro erano della stessa
    // persona — la ricucitura che togliere il `clientId` doveva impedire
    // (#584, secondo giro). La difesa sta nel client, in pathsCollector.js: il
    // percorso entra in una coda e parte ore dopo, da solo.
    match /paths/{domain} {
      // Vecchia forma piatta + elenco dei domini: chiusi, per sempre.
      allow read, write: if false;

      match /entries/{doc} {
        // Lettura per dominio. Il tetto sulla `limit` non protegge un segreto
        // (questi dati sono condivisi per progetto): tiene solo la singola
        // richiesta a una manciata di percorsi, quanti ne consuma il prompt.
        allow get: if true;
        allow list: if request.query.limit <= 200;

        // Nessun client scrive (#585): il percorso entra solo dalla callable
        // `pathSubmit`, che usa l'Admin SDK e bypassa queste regole. Qui non
        // c'è nessun controllo di forma perché non servirebbe a niente: una
        // regola non vede mai la scrittura che deve fermare, e quella che vede
        // la ferma sempre.
        allow create, update, delete: if false;
      }
    }

    // ── Collezioni del backend di sicurezza (filo-security, DESIGN §13) ──────
    // Scritte SOLO dal backend server-side via Admin SDK, che BYPASSA queste
    // regole. Per il client sono di sola lettura admin (futuri pannelli di
    // audit dell'owner) e MAI scrivibili: niente accesso utente.
    //
    // - identities/* : stato per account/IP (clean/spam/dangerous), contatori.
    // - attacks/*    : corpus dei tentativi (testo, verdetti, sorgente etichetta).
    // - judge-verdicts/* : log dei giudizi L2 (audit/benchmark).
    // La logica e i prompt dei giudici NON vivono qui (sono nel backend
    // privato): queste collezioni contengono solo stato/dati, non il "cervello".
    match /identities/{doc} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /attacks/{doc} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /judge-verdicts/{doc} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ── Canale red-team (filo-redteam-ux-spec §9, DESIGN §9) ─────────────────
    // SERVER-AUTHORITATIVE: scritto SOLO dal backend via Admin SDK (bypassa
    // queste regole). Il client NON scrive MAI — altrimenti un utente si
    // auto-verificherebbe, falsificherebbe punteggi/ricompense o si auto-
    // attribuirebbe verdetti. Le LETTURE del client passano tutte da Cloud
    // Function (redteamState/redteamAttempt/redteamLeaderboard, Admin SDK), che
    // applicano il gating (proprietario, verificato). Quindi qui la lettura
    // diretta è negata al client (solo admin, per pannelli owner futuri).
    //
    // redteam-users/{uid} : verifica + handle + stato gamification (bestPerJudge,
    //   gridUnlocked, milestones, leaderboardScore) + contatori. Lettura del
    //   PROPRIO doc consentita (abilita un eventuale listener real-time; non
    //   espone dati altrui), oltre all'admin.
    match /redteam-users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow read: if isAdmin();
      allow write: if false;
    }
    // redteam-attempts/{id} : tentativi (testo, descrizione, verdetti, score). I
    //   non verificati NON devono vedere i risultati (spec §7.1): per non
    //   replicare quel gating nelle regole, la lettura diretta è solo admin; il
    //   client usa la callable redteamAttempt (che verifica proprietà + stato).
    match /redteam-attempts/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
    // redteam-codes/{code} : codici monouso. Il codice è l'UNICA prova di
    //   abilitazione: se il client potesse leggerli si verificherebbe da solo →
    //   lettura solo admin, scrittura solo server-side (riscatto/generazione).
    match /redteam-codes/{code} {
      allow read: if isAdmin();
      allow write: if false;
    }
    // redteam-handles/{h} : prenotazione handle (unicità leaderboard). Solo backend.
    match /redteam-handles/{h} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
