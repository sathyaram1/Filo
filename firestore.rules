rules_version = '2';

// Regole per l'alpha test di Filo.
//
// Modello di sicurezza (vedi Filo/SECURITY.md):
// - Chiunque può CREARE un feedback (anonimo, nessun login).
// - La LETTURA è pubblica (serve alla dashboard e alla futura pagina pubblica
//   dei feedback). NB: per questo le `notes` sono leggibili da tutti — non
//   metterci dentro segreti.
// - Solo gli ADMIN (email nella collezione `admins`) possono fare triage
//   (update di stato/note/priorità) o cancellare. L'identità admin è provata
//   da un token Google verificato inviato come `Authorization: Bearer <idToken>`.
//
// Gli admin si gestiscono dalla console Firebase aggiungendo un documento in
// `admins/` con l'email come ID. Le regole NON permettono di modificare
// `admins` dal client (niente privilege escalation): si tocca solo da console.
//
// RUOLO "routines" (limitato). Le routine cloud (Claude su claude.ai) fanno
// triage automatico ma NON sono admin pieni: possono solo spostare un feedback
// tra `todo`, `done` e `clarify` e scriverne le `notes`/`resolvedAt`. NON
// possono cancellare, marcare `verified`/`ignored`, toccare la `priority`, né
// scrivere su altre collezioni. L'identità routine si prova come quella admin
// (token Google verificato), ma l'allowlist sta nella collezione `routines`,
// anch'essa gestita SOLO da console. Così, anche se il refresh token della
// routine trapelasse (la piattaforma routine non ha un secret store sicuro),
// il danno massimo è rimescolare gli stati di triage: nessuna distruzione di
// dati né escalation di privilegi.

service cloud.firestore {
  match /databases/{database}/documents {

    // Un richiedente è admin se è loggato con email verificata ed esiste un
    // documento `admins/<sua-email>`. exists() è una lettura privilegiata del
    // motore di regole: non dipende dalle regole di read di `admins`.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/admins/$(request.auth.token.email));
    }

    // Un richiedente è una routine se è loggato con email verificata ed esiste
    // un documento `routines/<sua-email>`. Ruolo deliberatamente debole.
    function isRoutine() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/routines/$(request.auth.token.email));
    }

    // Allowlist amministratori. Gestita SOLO da console Firebase.
    match /admins/{email} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Allowlist routine. Gestita SOLO da console Firebase.
    match /routines/{email} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Config "modelli predefiniti" condivisa, propagata a tutte le installazioni.
    // Scrittura riservata agli admin (l'editor in app passa dal main con il
    // Firebase ID token come Bearer).
    //
    // config/models  → provider/models/modelRegistry. NON è segreto
    //   (sono solo nomi di modelli): lettura PUBBLICA, così anche un utente non
    //   loggato riceve la config predefinita.
    // config/secrets → apiKeys predefinite (openrouter/gemini/tavily). SONO
    //   segrete: lettura solo per utenti loggati (consumate esclusivamente nel
    //   main process, mai inviate alle pagine). Chi non è loggato ricade sulle
    //   chiavi di build.
    match /config/models {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /config/secrets {
      allow read: if request.auth != null
        && request.auth.token.email_verified == true;
      allow write: if isAdmin();
    }

    // config/judgeSecrets → chiave OpenRouter DEDICATA ai giudici di sicurezza,
    // SEPARATA dalle chiavi del resto di Filo (DESIGN §4/§14). L'owner la imposta
    // dalla schermata "Modelli di supporto"; il backend filo-security la legge via
    // Admin SDK (bypassa le regole). Più stretta di config/secrets: lettura e
    // scrittura SOLO admin (nessun altro utente loggato può leggerla). Campo:
    // `openrouterKey` (stringa).
    match /config/judgeSecrets {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // config/automation → config dell'auto-miglioramento (vedi filo-security
    // DESIGN §2). Campi:
    //   - `enabled` (bool; assente = false = OFF, lo stato sicuro): interruttore
    //     dell'ingresso automatico in coda (un feedback giudicato sicuro entra
    //     da solo). NON è l'interruttore delle routine: quello sta in
    //     config/routines, vedi sotto.
    //   - `autoApprove` (mappa categoria d'autore → bool, una voce per ogni
    //     icona che la coda mostra; assente = tutti true): quali mittenti
    //     entrano in coda da soli quando `enabled` è true (#446). La legge il
    //     backend di sicurezza via Admin SDK.
    //   - `workerLog` (array di { role, startedAt, num }): il registro dei worker
    //     mostrato in dashboard. Lo scrive il server (functions, Admin SDK) al
    //     rilascio di ogni biglietto (le routine non hanno credenziali: #451).
    // Le regole NON enumerano i campi (read/write admin-only): nuovi campi non
    // richiedono redeploy. Riservato agli admin: nessun utente normale legge/scrive.
    match /config/automation {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // config/routines → come devono comportarsi le routine autonome. Campi:
    //   - `enabled` (bool; assente = true = comportamento storico): interruttore
    //     MASTER delle routine. Spento, l'orchestratore parte ma il dispatcher
    //     non consegna nulla a nessuno.
    //   - `proberWhenIdle` (bool; assente = true): a coda vuota le routine
    //     esplorano l'app in cerca di problemi (#448).
    //   - `loopCap` (int 1-10; assente = 3): quante FAIL del verifier prima del
    //     blocco `loop`.
    //
    // LETTURA PUBBLICA, e non è una svista. Chi lo legge sono le macchine delle
    // routine, che NON hanno nessuna credenziale (né service account né token
    // dell'owner). Finché queste tre impostazioni sono vissute in un documento
    // admin-only, la lettura falliva sempre e si ricadeva sui default: la
    // dashboard le mostrava attive e nei fatti non hanno mai raggiunto una
    // routine. Un interruttore che non arriva a destinazione è peggio che
    // assente — e qui dentro non c'è niente di segreto: solo se le routine
    // devono lavorare. La SCRITTURA resta solo all'owner.
    match /config/routines {
      allow read: if true;
      allow write: if isAdmin();
    }

    // config/supportModels → modelli per gli slot di supporto (sanitizer,
    // judge1, judge2, judge3, judgeDynamic, judgeRedTeam, judgePriority). Ogni
    // campo è una stringa catena di nickname ("flash, flash-or"), stesso
    // formato di config/models. Le regole NON enumerano i campi (read/write
    // admin-only), quindi nuovi slot non richiedono un redeploy.
    // Lettura riservata agli admin dal client; il backend filo-security la legge
    // via Admin SDK (bypassa queste regole). Scrittura solo admin.
    match /config/supportModels {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /feedback/{doc} {
      allow read: if true;

      // Creazione admin: senza vincoli di forma. Serve all'applier locale
      // dell'owner (npm run feedback:apply col token admin) per creare i
      // sub-feedback accodati dalle routine, che portano campi non previsti
      // dal create anonimo (status, notes, seq/subSeq, priority…).
      allow create: if isAdmin();

      // `name` = titolo breve generato da un LLM all'invio; `seq`/`subSeq` =
      // numero progressivo leggibile (#22, #22.1) calcolato dal client.
      // `parentId` (DC4): presente solo quando questo feedback è la riapertura
      // di un fix "Risolti" — collega al doc originale (ID Firestore, stessa
      // forma usata altrove nel repo: alfanumerico/`-`/`_`).
      allow create: if
        request.resource.data.keys().hasOnly(
          ['text', 'url', 'title', 'name', 'userAgent', 'clientId', 'clientIdHash', 'images',
           'files', 'createdAt', 'seq', 'subSeq', 'parentId',
           'statusPublic',   // S1.F2.1: aggiunto statusPublic (sempre in chiaro, nuovo nei submit)
           'capabilityGapId' // F4: id gap capacità per dedup auto-feedback (F5)
          ]
        )
        // S1.F2.1: se presente, statusPublic deve essere un valore valido.
        && request.resource.data.get('statusPublic', 'open') in ['open', 'closed', 'pending-approval']
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 10000
        && request.resource.data.get('url', '') is string
        && request.resource.data.get('url', '').size() <= 2000
        && request.resource.data.get('title', '') is string
        && request.resource.data.get('title', '').size() <= 500
        && request.resource.data.get('name', '') is string
        && request.resource.data.get('name', '').size() <= 200
        && request.resource.data.get('userAgent', '') is string
        && request.resource.data.get('userAgent', '').size() <= 500
        // S1.F2.2: clientId può essere raw (<=100) o cifrato FENC1: (<=300).
        && request.resource.data.get('clientId', '') is string
        && request.resource.data.get('clientId', '').size() <= 300
        // S1.F2.2: clientIdHash — hash SHA-256 troncato in chiaro (32 char hex) per match C5.
        && request.resource.data.get('clientIdHash', '') is string
        && request.resource.data.get('clientIdHash', '').size() <= 64
        && request.resource.data.get('images', []) is list
        && request.resource.data.get('images', []).size() <= 5
        && request.resource.data.get('files', []) is list
        && request.resource.data.get('files', []).size() <= 5
        && request.resource.data.get('seq', 0) is int
        && request.resource.data.get('seq', 0) >= 0
        && request.resource.data.get('seq', 0) <= 1000000
        && request.resource.data.get('subSeq', 0) is int
        && request.resource.data.get('subSeq', 0) >= 0
        && request.resource.data.get('subSeq', 0) <= 100000
        && request.resource.data.get('parentId', '') is string
        && request.resource.data.get('parentId', '').size() <= 128
        // F4: capabilityGapId — opzionale, solo per auto-feedback (clientId 'auto:*').
        && request.resource.data.get('capabilityGapId', '') is string
        && request.resource.data.get('capabilityGapId', '').size() <= 100;

      // Triage admin (pieno): campi di stato/note/priorità/timestamp, più
      // numero e titolo (per backfill/rinomina). Il resto resta immutabile.
      // `claimedBy`/`claimedAt`/`claimExpiresAt`/`claimNum` = "semaforo" che una
      // routine ha preso in carico il feedback. Il lock vero lo tiene il server
      // (il semaforo del biglietto); questi campi servono SOLO alla dashboard
      // per mostrare "in lavorazione". Stringhe (ISO/etichetta); '' = libero.
      allow update: if
        isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
          // S1.F2.1: aggiunto statusPublic (enum grossolano in chiaro) e resolvedInVersion.
          .hasOnly(['status', 'statusPublic', 'notes', 'resolvedAt', 'verifiedAt', 'priority',
                    'priorityManual', // P6: flag manuale owner (il giudice auto non sovrascrive)
                    // Macchina a stati (FEEDBACK-STATES.md): statusReason = sottotesto
                    // dello status (loop/clarify/…), workingSince = timestamp del lock,
                    // workingResets = interruzioni consecutive (riconciliazione §6).
                    'statusReason', 'workingSince', 'workingResets',
                    'name', 'seq', 'subSeq', 'branch', 'blockReason', 'starred',
                    'claimedBy', 'claimedAt', 'claimExpiresAt', 'claimNum',
                    'reviewDecision', 'reviewComment', 'reviewedAt', 'resolvedInVersion',
                    // I DUE TESTI: 'notes' e' il report per l'owner (cifrato),
                    // 'userNote' la frase in chiaro per chi ha mandato il feedback.
                    'userNote',
                    'archiveOverride', 'reopenRequests',
                    'capabilityGapId']) // F4: permettere update del gap id (backfill)
        // S1.F2.1: status accetta l'enum esistente O un ciphertext FENC1: (gate on).
        // Enum: stati CANONICI della macchina a stati (FEEDBACK-STATES.md) +
        // legacy ritirati (documenti storici non ancora migrati).
        && (request.resource.data.get('status', 'new') in
              ['unlabeled', 'suspicious_file', 'attack', 'spam', 'design', 'aligned',
               'todo', 'working', 'revision_capability', 'revision_security', 'done',
               'archived', 'attack_confirmed', 'spam_confirmed',
               'new', 'draft', 'clarify', 'review', 'blocked', 'verified', 'ignored']
            || request.resource.data.get('status', '').matches('^FENC1:.*'))
        // S1.F2.1: statusPublic (se presente) deve essere uno dei tre valori grossolani.
        && request.resource.data.get('statusPublic', 'open') in ['open', 'closed', 'pending-approval']
        && request.resource.data.get('statusReason', '') is string
        && request.resource.data.get('statusReason', '').size() <= 60
        && request.resource.data.get('workingSince', '') is string
        && request.resource.data.get('workingSince', '').size() <= 40
        // `workingResets`: contatore delle lavorazioni interrotte di fila
        // (working scaduto → todo); alla soglia la riconciliazione passa a
        // design/loop. Piccolo per costruzione.
        && request.resource.data.get('workingResets', 0) is int
        && request.resource.data.get('workingResets', 0) >= 0
        && request.resource.data.get('workingResets', 0) <= 100
        // `notes` = CONVERSAZIONE del feedback (report delle routine + risposte
        // dell'owner + righe-allegato): cresce a ogni turno. Il tetto vale per
        // il documento RISULTANTE, quindi note oltre il limite bloccherebbero
        // QUALUNQUE scrittura sul feedback (anche il solo cambio di stato) —
        // il feedback diventerebbe immobile. Tenere allineato a
        // SN_FEEDBACK_THREAD.NOTES_MAX (src/shared/feedbackThread.js), che
        // taglia i turni più vecchi lato scrittura.
        && request.resource.data.get('notes', '') is string
        && request.resource.data.get('notes', '').size() <= 60000
        // La frase per l'utente e' corta per costruzione: e' l'unico dei due
        // testi che resta leggibile da tutti, e un tetto stretto la tiene tale.
        && request.resource.data.get('userNote', '') is string
        && request.resource.data.get('userNote', '').size() <= 500
        // S1.priority: priority accetta int 0-3 (legacy in chiaro) OPPURE
        // una stringa ciphertext FENC1: (gate on). Retrocompatibile.
        && (
             (request.resource.data.get('priority', 0) is int
              && request.resource.data.get('priority', 0) >= 0
              && request.resource.data.get('priority', 0) <= 3)
             || (request.resource.data.get('priority', '') is string
                 && request.resource.data.get('priority', '').matches('^FENC1:.*'))
           )
        && request.resource.data.get('name', '') is string
        && request.resource.data.get('name', '').size() <= 200
        && request.resource.data.get('seq', 0) is int
        && request.resource.data.get('seq', 0) >= 0
        && request.resource.data.get('subSeq', 0) is int
        && request.resource.data.get('subSeq', 0) >= 0
        && request.resource.data.get('claimedBy', '') is string
        && request.resource.data.get('claimedBy', '').size() <= 120
        && request.resource.data.get('claimedAt', '') is string
        && request.resource.data.get('claimedAt', '').size() <= 40
        && request.resource.data.get('claimExpiresAt', '') is string
        && request.resource.data.get('claimExpiresAt', '').size() <= 40
        && request.resource.data.get('claimNum', '') is string
        && request.resource.data.get('claimNum', '').size() <= 20
        // `branch`: nome del branch git su cui vive il fix in attesa di verifica
        // (stati `review`/`blocked` del cancello di merge delle routine).
        && request.resource.data.get('branch', '') is string
        && request.resource.data.get('branch', '').size() <= 200
        // `blockReason`: motivo strutturato del blocco (es. 'loop' = 3 FAIL del
        // verifier→fixer). Usato dalla dashboard `manage` per il colore del bordo.
        && request.resource.data.get('blockReason', '') is string
        && request.resource.data.get('blockReason', '').size() <= 60
        // `starred` (DB2): flag ⭐ "preferito"/parcheggiato, settabile su
        // qualunque feedback dall'owner. Booleano puro.
        && request.resource.data.get('starred', false) is bool
        // `priorityManual` (P6): flag booleano — l'owner ha impostato la priorità
        // a mano. Il giudice automatico (filo-security) lo rispetta e non sovrascrive.
        && request.resource.data.get('priorityManual', false) is bool
        // Override di revisione: l'owner sblocca/conferma a mano un feedback
        // fermato dalla sicurezza, con un commento opzionale. `reviewDecision`
        // 'accepted' lo riammette nel flusso (vedi SN_MANAGE_REVIEW.classifyBlock).
        //
        // #476: i tre campi ora viaggiano CIFRATI (in chiaro dicevano a chi
        // aveva mandato il feedback che era stato fermato). Le regole non
        // possono più enumerare i valori — un ciphertext è una stringa opaca —
        // quindi restano forma e tetto, che è ciò che le regole sanno fare.
        // I valori storici in chiaro continuano a passare.
        && request.resource.data.get('reviewDecision', '') is string
        && request.resource.data.get('reviewDecision', '').size() <= 400
        // #476: il commento ora viaggia CIFRATO (lo leggeva chiunque, compreso
        // chi aveva mandato l'attacco che l'owner stava confermando). La
        // cifratura gonfia il testo di circa il 40% più un preambolo fisso:
        // 2000 caratteri scritti diventano ~2800. Il tetto sale di conseguenza,
        // altrimenti un commento lungo verrebbe respinto qui — stesso
        // ragionamento del `clientId` (grezzo ≤100, cifrato ≤300).
        && request.resource.data.get('reviewComment', '') is string
        && request.resource.data.get('reviewComment', '').size() <= 4000
        && request.resource.data.get('reviewedAt', '') is string
        && request.resource.data.get('reviewedAt', '').size() <= 400   // cifrato (#476)
        // Override owner per l'archiviazione automatica a punteggio (DC3):
        // 'archived' = l'owner ha archiviato a mano (vince sempre su punteggio
        // /età); 'keep_open' = l'owner ha deciso esplicitamente di NON
        // archiviare nonostante il punteggio. '' = nessun override (substrato
        // SN_BOARD_ARCHIVE.hasOwnerOverride).
        && request.resource.data.get('archiveOverride', '') in ['', 'archived', 'keep_open']
        // `reopenRequests` (DC4): l'admin può azzerarlo (es. {}) quando un fix
        // riaperto viene risistemato e rispedito, sbloccando una futura
        // riapertura sullo stesso doc. Nessun vincolo di forma extra qui: il
        // ramo non-admin sotto resta l'unico modo per gli utenti di scriverlo.
        && request.resource.data.get('reopenRequests', {}) is map
        // F4: capabilityGapId (opzionale) — id strutturale del gap di capacità
        // per il dedup auto-feedback. Stringa breve.
        && request.resource.data.get('capabilityGapId', '') is string
        && request.resource.data.get('capabilityGapId', '').size() <= 100;

      // Voto di verifica della board utente (DB4): un utente LOGGATO scrive SOLO
      // il proprio voto nel map `votes` (chiave = suo uid). Un voto per utente,
      // cambiabile (ri-PATCH della stessa chiave) e ritirabile (cancellazione
      // della chiave). La read del feedback è già pubblica. Il vincolo
      // chiave==uid impedisce di toccare i voti altrui o qualunque altro campo:
      // l'unica chiave del map che può cambiare è quella del richiedente.
      // Entry: { vote: 'works'|'broken', at: <ISO>, credibilitySnapshot: <num> }.
      // È il substrato che board (DC*) e archiviazione a punteggio (DC3) leggono.
      allow update: if
        request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes'])
        && request.resource.data.get('votes', {}) is map
        && request.resource.data.get('votes', {})
             .diff(resource.data.get('votes', {})).affectedKeys()
             .hasOnly([request.auth.uid])
        && (
             !(request.auth.uid in request.resource.data.get('votes', {}))
             || (
                  request.resource.data.votes[request.auth.uid].keys()
                    .hasOnly(['vote', 'at', 'credibilitySnapshot'])
                  && request.resource.data.votes[request.auth.uid].vote in ['works', 'broken']
                  && request.resource.data.votes[request.auth.uid].at is string
                  && request.resource.data.votes[request.auth.uid].at.size() <= 40
                  && request.resource.data.votes[request.auth.uid].credibilitySnapshot is number
                  && request.resource.data.votes[request.auth.uid].credibilitySnapshot >= 0
                )
           );

      // Riapertura a pagamento dalla board (DC4): un utente LOGGATO scrive SOLO
      // la propria chiave nel map `reopenRequests` (stesso pattern di `votes`
      // sopra — chiave==uid, nessun altro campo toccabile). È solo il SEGNALE
      // "ho chiesto la riapertura": non tocca `status` (quello resta admin/
      // routine, vedi i rami sopra) — il flip fuori da "Risolti" lo applica il
      // percorso fidato leggendo questo campo. Entry: { at: <ISO> }.
      allow update: if
        request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reopenRequests'])
        && request.resource.data.get('reopenRequests', {}) is map
        && request.resource.data.get('reopenRequests', {})
             .diff(resource.data.get('reopenRequests', {})).affectedKeys()
             .hasOnly([request.auth.uid])
        && (
             !(request.auth.uid in request.resource.data.get('reopenRequests', {}))
             || (
                  request.resource.data.reopenRequests[request.auth.uid].keys()
                    .hasOnly(['at'])
                  && request.resource.data.reopenRequests[request.auth.uid].at is string
                  && request.resource.data.reopenRequests[request.auth.uid].at.size() <= 40
                )
           );

      // Triage routine (limitato): può solo muovere l'ITER DI LAVORAZIONE della
      // macchina a stati (todo/working/revision_*/done/design) e scrivere
      // `notes`/`resolvedAt`/`statusReason`/`workingSince`/`branch`. NON tocca
      // `priority`, NON archivia, NON conferma attacchi, NON cancella. Più
      // stretto del ramo admin di proposito: è il contenimento del blast radius
      // del ruolo routine. (`clarify` legacy resta per la transizione.)
      allow update: if
        isRoutine()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'notes', 'resolvedAt', 'statusReason', 'workingSince', 'branch'])
        && request.resource.data.get('status', 'new') in
             ['todo', 'working', 'revision_capability', 'revision_security', 'done', 'design', 'clarify']
        && request.resource.data.get('statusReason', '') is string
        && request.resource.data.get('statusReason', '').size() <= 60
        && request.resource.data.get('workingSince', '') is string
        && request.resource.data.get('workingSince', '').size() <= 40
        && request.resource.data.get('branch', '') is string
        && request.resource.data.get('branch', '').size() <= 200
        // Stesso tetto del ramo admin (SN_FEEDBACK_THREAD.NOTES_MAX): i due
        // rami devono restare allineati, o una routine potrebbe scrivere note
        // che poi bloccano l'owner.
        && request.resource.data.get('notes', '') is string
        && request.resource.data.get('notes', '').size() <= 60000;

      // Cancellazione: solo admin.
      allow delete: if isAdmin();
    }

    // Crediti (gamification): un documento per utente, ID = uid Firebase.
    // Ogni utente legge/scrive SOLO il proprio doc. È client-authoritative:
    // l'app desktop calcola saldo/consumo nel main e sincronizza qui. In alpha
    // accettiamo il caveat (un utente potrebbe gonfiarsi i crediti manomettendo
    // il client): i crediti non danno accesso a risorse altrui né a dati di
    // altri utenti, quindi il blast radius è solo "barare col proprio saldo".
    // Se in futuro i crediti diventano spendibili per davvero, va spostato il
    // calcolo su una Cloud Function autorevole.
    // Oltre al proprietario, anche un ADMIN può leggere e scrivere qualsiasi
    // doc credits: serve ai comandi proprietario /users (elenco utenti) e /gift
    // (accredito crediti a un altro account). L'app desktop sincronizza qui
    // anche `email`/`name` dell'utente, così l'admin può risolvere email→uid e
    // listare gli iscritti. Resta client-authoritative per il saldo proprio.
    match /credits/{uid} {
      allow read, write: if request.auth != null
        && request.auth.uid == uid;
      allow read, write: if isAdmin();
    }

    // Percorsi di navigazione raccolti dalla sidebar "Aiuto" (Fase 2).
    // Tupla anonima (sito, posizione iniziale, intento, azioni, esito) usata
    // per insegnare globalmente all'AI come muoversi su un dominio.
    // Lo schema è validato a monte dal client: la raccolta passa per due LLM
    // distinti (intent guess + judge) che impediscono che dati raw dell'utente
    // finiscano qui dentro. Le regole sotto fanno solo il check di forma.
    match /paths/{doc} {
      allow read: if true;

      allow create: if
        request.resource.data.keys().hasOnly(
          ['domain', 'initialUrl', 'intent', 'steps', 'success',
           'userAgent', 'clientId', 'createdAt']
        )
        && request.resource.data.domain is string
        && request.resource.data.domain.size() > 0
        && request.resource.data.domain.size() <= 253
        && request.resource.data.initialUrl is string
        && request.resource.data.initialUrl.size() <= 2000
        && request.resource.data.intent is string
        && request.resource.data.intent.size() <= 500
        && request.resource.data.steps is list
        && request.resource.data.steps.size() <= 30
        && request.resource.data.success is bool
        && request.resource.data.get('userAgent', '') is string
        && request.resource.data.get('userAgent', '').size() <= 500
        && request.resource.data.get('clientId', '') is string
        && request.resource.data.get('clientId', '').size() <= 100;

      allow update: if false;
      allow delete: if false;
    }

    // ── Collezioni del backend di sicurezza (filo-security, DESIGN §13) ──────
    // Scritte SOLO dal backend server-side via Admin SDK, che BYPASSA queste
    // regole. Per il client sono di sola lettura admin (futuri pannelli di
    // audit dell'owner) e MAI scrivibili: niente accesso utente.
    //
    // - identities/* : stato per account/IP (clean/spam/dangerous), contatori.
    // - attacks/*    : corpus dei tentativi (testo, verdetti, sorgente etichetta).
    // - judge-verdicts/* : log dei giudizi L2 (audit/benchmark).
    // La logica e i prompt dei giudici NON vivono qui (sono nel backend
    // privato): queste collezioni contengono solo stato/dati, non il "cervello".
    match /identities/{doc} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /attacks/{doc} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /judge-verdicts/{doc} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ── Canale red-team (filo-redteam-ux-spec §9, DESIGN §9) ─────────────────
    // SERVER-AUTHORITATIVE: scritto SOLO dal backend via Admin SDK (bypassa
    // queste regole). Il client NON scrive MAI — altrimenti un utente si
    // auto-verificherebbe, falsificherebbe punteggi/ricompense o si auto-
    // attribuirebbe verdetti. Le LETTURE del client passano tutte da Cloud
    // Function (redteamState/redteamAttempt/redteamLeaderboard, Admin SDK), che
    // applicano il gating (proprietario, verificato). Quindi qui la lettura
    // diretta è negata al client (solo admin, per pannelli owner futuri).
    //
    // redteam-users/{uid} : verifica + handle + stato gamification (bestPerJudge,
    //   gridUnlocked, milestones, leaderboardScore) + contatori. Lettura del
    //   PROPRIO doc consentita (abilita un eventuale listener real-time; non
    //   espone dati altrui), oltre all'admin.
    match /redteam-users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow read: if isAdmin();
      allow write: if false;
    }
    // redteam-attempts/{id} : tentativi (testo, descrizione, verdetti, score). I
    //   non verificati NON devono vedere i risultati (spec §7.1): per non
    //   replicare quel gating nelle regole, la lettura diretta è solo admin; il
    //   client usa la callable redteamAttempt (che verifica proprietà + stato).
    match /redteam-attempts/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
    // redteam-codes/{code} : codici monouso. Il codice è l'UNICA prova di
    //   abilitazione: se il client potesse leggerli si verificherebbe da solo →
    //   lettura solo admin, scrittura solo server-side (riscatto/generazione).
    match /redteam-codes/{code} {
      allow read: if isAdmin();
      allow write: if false;
    }
    // redteam-handles/{h} : prenotazione handle (unicità leaderboard). Solo backend.
    match /redteam-handles/{h} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
