    // ── La sicurezza dei contatori (#1474) ───────────────────────────────────
    //
    // Per ogni ora che ne ha, solo numeri sotto chiavi di elenchi chiusi, copie di quelli del codice: il verdetto di ogni
    // pagina aperta (livello e motivi del motore), l'esito e la durata in fasce dei controlli di rete del verdetto e se
    // l'hanno cambiato, le scelte sull'avviso del sito, i lavori fermati da una pagina delicata (per categoria, e quando
    // il filtro si è rotto), le richieste ai modelli partite con un segreto tolto (per tipo e funzione), le uscite fermate
    // (regola, tipo di segreto e tipo d'azione) e i tetti del codice toccati. Mai un dominio, un indirizzo o un segreto.
    // Stesso pseudonimo, stessa ora e stesso id dell'ora, in un documento suo per il tetto delle espressioni; le stesse
    // regole: sola creazione con l'identità anonima, forma fissa, legge solo l'admin. Sentinella:
    // tests/unit/firestoreRulesContatoriSicurezza.test.mjs.
    match /contatori-sicurezza/{docId} {
      function conti(m, chiavi, tettoChiavi, tetto) {
        return m is map && m.keys().join('#').size() <= tettoChiavi && m.keys().join('#').matches(chiavi)
          && m.values().join('#').size() <= tetto && m.values().join('#').matches('^([0-9]{1,9}(#[0-9]{1,9})*)?$');
      }
      function contatoriSicurezza(d) {
        return d.keys().hasOnly(['v', 'pseudonimo', 'giorno', 'mese', 'ora', 'app', 'os', 'sito_verdetto', 'sito_approfondito', 'avviso_scelta', 'pagina_delicata', 'segreto_oscurato', 'uscita_fermata', 'tetto_toccato'])
          && d.keys().hasAll(['v', 'pseudonimo', 'giorno', 'mese', 'ora', 'app', 'os', 'sito_verdetto', 'sito_approfondito', 'avviso_scelta', 'pagina_delicata', 'segreto_oscurato', 'uscita_fermata', 'tetto_toccato'])
          && d.v == 1
          && d.pseudonimo is string && d.pseudonimo.matches('^[0-9a-f]{20}$')
          && d.giorno is string && d.giorno.matches('^20[0-9]{2}-[01][0-9]-[0-3][0-9]$')
          && d.mese is string && d.mese.matches('^20[0-9]{2}-[01][0-9]$')
          && d.giorno.matches(d.mese + '-[0-3][0-9]')
          && d.ora is string && d.ora.matches('^([01][0-9]|2[0-3])$')
          && docId == d.pseudonimo + '_' + d.giorno + '_' + d.ora
          && d.app is string && d.app.matches('^[0-9]{1,4}[.][0-9]{1,4}[.][0-9]{1,6}$')
          && d.os in ['win', 'mac', 'linux', 'altro']
          && conti(d.sito_verdetto, '^((safe|sospetto|pericoloso)([:](gsb_malware|gsb_phishing|gsb_unwanted|gsb_listed|strict_impersonation|broad_impersonation|weak_typo|young_domain|cert_expired|cert_mismatch|cert_self_signed|cert_untrusted|cert_absent|cert_revoked|sandbox_dangerous|llm|insecure_form|insecure_transport|sensitive_input|auto_download|double_extension|hosted_content|whitelisted|clean|local_host|unparsable|altro))?(#(safe|sospetto|pericoloso)([:](gsb_malware|gsb_phishing|gsb_unwanted|gsb_listed|strict_impersonation|broad_impersonation|weak_typo|young_domain|cert_expired|cert_mismatch|cert_self_signed|cert_untrusted|cert_absent|cert_revoked|sandbox_dangerous|llm|insecure_form|insecure_transport|sensitive_input|auto_download|double_extension|hosted_content|whitelisted|clean|local_host|unparsable|altro))?)*)?$', 3600, 1700)
          && conti(d.sito_approfondito, '^(((gsb|rdap|ct|sandbox|llm)[:]((ok|transitorio|fallito)[:](ms500|s1|s2|s5|s10|s30|oltre)|non_configurato)|cert[:](ok|fallito)|cambiato[:](si|no))(#((gsb|rdap|ct|sandbox|llm)[:]((ok|transitorio|fallito)[:](ms500|s1|s2|s5|s10|s30|oltre)|non_configurato)|cert[:](ok|fallito)|cambiato[:](si|no)))*)?$', 3800, 2300)
          && conti(d.avviso_scelta, '^((procedi|continua|indietro|copia|chiedi|segnala_falso_allarme)[:](sospetto|pericoloso)[:](prima_di_aprire|dopo)(#(procedi|continua|indietro|copia|chiedi|segnala_falso_allarme)[:](sospetto|pericoloso)[:](prima_di_aprire|dopo))*)?$', 1500, 500)
          && conti(d.pagina_delicata, '^((utente|posta|banche|sanita|pa|campi|altro|filtro_guasto)[:](descrizione_automatica|spiegazione_preparata|contesto_correttore|riquadri|schermo|riordino_schede|riassunto_schede)(#(utente|posta|banche|sanita|pa|campi|altro|filtro_guasto)[:](descrizione_automatica|spiegazione_preparata|contesto_correttore|riquadri|schermo|riordino_schede|riassunto_schede))*)?$', 2700, 1200)
          && conti(d.segreto_oscurato, '^((portafoglio|accesso|identita|feedback|chiave|altro)[:][a-z][a-z0-9-]{0,39}(#(portafoglio|accesso|identita|feedback|chiave|altro)[:][a-z][a-z0-9-]{0,39})*)?$', 51840, 9600)
          && conti(d.uscita_fermata, '^((custodito[:](portafoglio|accesso|identita|feedback|chiave|altro)|(codice|password|chiave|iban|carta|guasto|altro))[:](NAVIGA|LEGGI_PAGINA|CERCA_WEB|ESEGUI_COMANDO|INVIA_FEEDBACK|APRI_FILE|APRI_SALVATA|CERCA_DOCUMENTI|CAMPO_PAGINA|SCARICA_COLLEGAMENTO|altro)(#(custodito[:](portafoglio|accesso|identita|feedback|chiave|altro)|(codice|password|chiave|iban|carta|guasto|altro))[:](NAVIGA|LEGGI_PAGINA|CERCA_WEB|ESEGUI_COMANDO|INVIA_FEEDBACK|APRI_FILE|APRI_SALVATA|CERCA_DOCUMENTI|CAMPO_PAGINA|SCARICA_COLLEGAMENTO|altro))*)?$', 7200, 2900)
          && conti(d.tetto_toccato, '^((automatiche_spiegazioni|automatiche_correttore|riquadri_visioni|geo_budget|safebrowse_approfondimenti|link_accorciati|segreti_saturo|contatori_combinazioni)(#(automatiche_spiegazioni|automatiche_correttore|riquadri_visioni|geo_budget|safebrowse_approfondimenti|link_accorciati|segreti_saturo|contatori_combinazioni))*)?$', 400, 200);
      }
      allow get, list: if isAdmin();
      allow create: if request.auth != null && contatoriSicurezza(request.resource.data);
      allow update, delete: if false;
    }

    // ── I riquadri AI e l'Editor dei contatori (#1465) ───────────────────────
    //
    // Per ogni ora che ne ha, solo numeri sotto chiavi di elenchi chiusi: com'era la risposta preparata in anticipo
    // quando la persona l'ha aperta (Spiega, il correttore su una parola), i riquadri chiusi prima della risposta con
    // l'attesa in fasce, cosa se ne è fatto (Copia, quante domande dopo, Approfondisci, la risposta ricominciata), la
    // riscrittura (scorciatoia, esito, proposte), l'OCR, la traduzione della pagina (esito, parte rimasta, ritorno
    // all'originale entro un minuto), il titolo automatico dell'Editor e la sua chat. Mai un testo, un titolo o un
    // sito. Stesso pseudonimo, stessa ora e stesso id dell'ora, in un documento suo per il tetto delle espressioni; le
    // stesse regole: sola creazione, senza login, forma fissa, legge solo l'admin. Sentinella:
    // tests/unit/firestoreRulesContatori.test.mjs.
    match /contatori-riquadri/{docId} {
      function contatoriRiquadri(d) {
        return d.keys().hasOnly(['v', 'pseudonimo', 'giorno', 'mese', 'ora', 'app', 'os', 'anticipo_al_gesto', 'riquadro_chiuso_prima', 'riquadro_uso', 'riscrittura', 'ocr', 'traduzione_pagina', 'editor_titolo', 'editor_chat'])
          && d.keys().hasAll(['v', 'pseudonimo', 'giorno', 'mese', 'ora', 'app', 'os', 'anticipo_al_gesto', 'riquadro_chiuso_prima', 'riquadro_uso', 'riscrittura', 'ocr', 'traduzione_pagina', 'editor_titolo', 'editor_chat'])
          && d.v == 1
          && d.pseudonimo is string && d.pseudonimo.matches('^[0-9a-f]{20}$')
          && d.giorno is string && d.giorno.matches('^20[0-9]{2}-[01][0-9]-[0-3][0-9]$')
          && d.mese is string && d.mese.matches('^20[0-9]{2}-[01][0-9]$')
          && d.giorno.matches(d.mese + '-[0-3][0-9]')
          && d.ora is string && d.ora.matches('^([01][0-9]|2[0-3])$')
          && docId == d.pseudonimo + '_' + d.giorno + '_' + d.ora
          && d.app is string && d.app.matches('^[0-9]{1,4}[.][0-9]{1,4}[.][0-9]{1,6}$')
          && d.os in ['win', 'mac', 'linux', 'altro']
          && chiuse(d.anticipo_al_gesto, ['spiega', 'correttore_parola'], 100, '^([0-9]{1,9}(,[0-9]{1,9}){4}(#[0-9]{1,9}(,[0-9]{1,9}){4})*)?$')
          && chiuse(d.riquadro_chiuso_prima, ['explain', 'explain-deep', 'translate-selection', 'explain-link', 'describe-image'], 350, '^([0-9]{1,9}(,[0-9]{1,9}){6}(#[0-9]{1,9}(,[0-9]{1,9}){6})*)?$')
          && chiuse(d.riquadro_uso, ['explain', 'explain-deep', 'translate-selection', 'explain-link', 'describe-image'], 350, '^([0-9]{1,9}(,[0-9]{1,9}){6}(#[0-9]{1,9}(,[0-9]{1,9}){6})*)?$')
          && chiuse(d.riscrittura, ['formale', 'informale', 'riassumi', 'traduci', 'correggi', 'libera'], 600, '^([0-9]{1,9}(,[0-9]{1,9}){9}(#[0-9]{1,9}(,[0-9]{1,9}){9})*)?$')
          && chiuse(d.ocr, ['copiato', 'vuoto', 'annullato', 'tagliato'], 40, '^([0-9]{1,9}(#[0-9]{1,9})*)?$')
          && chiuse(d.traduzione_pagina, ['intera', 'parziale', 'fermata'], 240, '^([0-9]{1,9}(,[0-9]{1,9}){7}(#[0-9]{1,9}(,[0-9]{1,9}){7})*)?$')
          && chiuse(d.editor_titolo, ['automatico', 'rigenerato'], 140, '^([0-9]{1,9}(,[0-9]{1,9}){6}(#[0-9]{1,9}(,[0-9]{1,9}){6})*)?$')
          && chiuse(d.editor_chat, ['intero', 'oltre_tetto'], 120, '^([0-9]{1,9}(,[0-9]{1,9}){5}(#[0-9]{1,9}(,[0-9]{1,9}){5})*)?$');
      }
      allow get, list: if isAdmin();
      allow create: if request.auth != null && contatoriRiquadri(request.resource.data);
      allow update, delete: if false;
    }

    // La home e quello che Filo fa da sé sulla pagina in un'ora dei contatori (#1473), per nome da elenchi chiusi: i
    // comandi della barra della home, le ricerche nel filo (risultati, tipo e posto di quello aperto, quanto per
    // aprirlo, in fasce), i «risali» di fila, l'intervista rifatta dalle Preferenze e il passo dove si ferma, le
    // proposte sulla pagina per tipo ed esito, gli automatismi fatti e disfatti. Mai un testo, un sito o un paese.
    // Stesso pseudonimo, stessa ora e stesso id dell'ora, in un documento suo per il tetto delle espressioni; le stesse
    // regole: sola creazione, senza login, forma fissa, legge solo l'admin. Sentinella:
    // tests/unit/firestoreRulesContatoriHomePagina.test.mjs.
    match /contatori-home-pagina/{docId} {
      function conti(m, chiavi, tettoChiavi, tetto) {
        return m is map && m.keys().join('#').size() <= tettoChiavi && m.keys().join('#').matches(chiavi)
          && m.values().join('#').size() <= tetto && m.values().join('#').matches('^([0-9]{1,9}(#[0-9]{1,9})*)?$');
      }
      function contatoriHomePagina(d) {
        return d.keys().hasOnly(['v', 'pseudonimo', 'giorno', 'mese', 'ora', 'app', 'os', 'comando_home', 'ricerca_home', 'risali', 'intervista_rifatta', 'proposta_sulla_pagina', 'automatismo_fatto', 'automatismo_disfatto'])
          && d.keys().hasAll(['v', 'pseudonimo', 'giorno', 'mese', 'ora', 'app', 'os', 'comando_home', 'ricerca_home', 'risali', 'intervista_rifatta', 'proposta_sulla_pagina', 'automatismo_fatto', 'automatismo_disfatto'])
          && d.v == 1
          && d.pseudonimo is string && d.pseudonimo.matches('^[0-9a-f]{20}$')
          && d.giorno is string && d.giorno.matches('^20[0-9]{2}-[01][0-9]-[0-3][0-9]$')
          && d.mese is string && d.mese.matches('^20[0-9]{2}-[01][0-9]$')
          && d.giorno.matches(d.mese + '-[0-3][0-9]')
          && d.ora is string && d.ora.matches('^([01][0-9]|2[0-3])$')
          && docId == d.pseudonimo + '_' + d.giorno + '_' + d.ora
          && d.app is string && d.app.matches('^[0-9]{1,4}[.][0-9]{1,4}[.][0-9]{1,6}$')
          && d.os in ['win', 'mac', 'linux', 'altro']
          && conti(d.comando_home, '^(((home|clear|clear_all|kill|newtab|models|modelli|sicurezza|preferenze|editor|feedback|pulisci|pulizia|riordina|set|invito|users|gift|help|sito_diretto|shell|sconosciuto_inviato)|sito_non_risolto[:](apri_lo_stesso|lascia))(#((home|clear|clear_all|kill|newtab|models|modelli|sicurezza|preferenze|editor|feedback|pulisci|pulizia|riordina|set|invito|users|gift|help|sito_diretto|shell|sconosciuto_inviato)|sito_non_risolto[:](apri_lo_stesso|lascia)))*)?$', 600, 500)
          && conti(d.ricerca_home, '^((risultati[:](r0|r1_3|r4_10|oltre)|aperto[:](messaggio|pagina|scheda_chiusa|conversazione_nascosta)[:](p1|p2_3|p4_10|oltre)[:](ms500|s1|s2|s5|s10|s30|oltre)|vuota_ripetuta)(#(risultati[:](r0|r1_3|r4_10|oltre)|aperto[:](messaggio|pagina|scheda_chiusa|conversazione_nascosta)[:](p1|p2_3|p4_10|oltre)[:](ms500|s1|s2|s5|s10|s30|oltre)|vuota_ripetuta))*)?$', 7000, 2400)
          && conti(d.risali, '^((n1|n2_3|n4_10|oltre)(#(n1|n2_3|n4_10|oltre))*)?$', 100, 100)
          && conti(d.intervista_rifatta, '^((riaperta|fine[:][a-z][a-z0-9_]{0,29})(#(riaperta|fine[:][a-z][a-z0-9_]{0,29}))*)?$', 1440, 400)
          && conti(d.proposta_sulla_pagina, '^(((apri_da_altro_paese|email_account|riquadro_rotto|resta_connesso)[:](accettata|rifiutata|spenta_per_sempre|ignorata)|email_account[:]accettata[:](clic|tastiera|menu))(#((apri_da_altro_paese|email_account|riquadro_rotto|resta_connesso)[:](accettata|rifiutata|spenta_per_sempre|ignorata)|email_account[:]accettata[:](clic|tastiera|menu)))*)?$', 1200, 400)
          && conti(d.automatismo_fatto, '^((banner_cookie|zoom_ricordato|segnalazione_automatica|pubblicita_saltata)(#(banner_cookie|zoom_ricordato|segnalazione_automatica|pubblicita_saltata))*)?$', 200, 100)
          && conti(d.automatismo_disfatto, '^((banner_cookie|zoom_ricordato|segnalazione_automatica)(#(banner_cookie|zoom_ricordato|segnalazione_automatica))*)?$', 200, 100);
      }
      allow get, list: if isAdmin();
      allow create: if contatoriHomePagina(request.resource.data);
      allow update, delete: if false;
    }

    // Le manopole dei crediti (euro per credito, ingresso, quota, inviti
    // rimasti, tetto globale) più cambio e somma dei tetti scritti dal server.
    // Campi non enumerati, come gli altri config/*: aggiungerne uno non
    // richiede un redeploy delle regole.
    match /config/credits {
      allow read, write: if isAdmin();
    }

    // Percorsi di navigazione raccolti dalla sidebar "Aiuto" (Fase 2).
    // Tupla anonima (sito, posizione iniziale, intento, azioni, esito) usata
    // per insegnare globalmente all'AI come muoversi su un dominio.
    //
    // SERVER-AUTHORITATIVE dal #585 (audit pre-alpha). È l'unica collezione che
    // attraversa il confine fra utenti: quello che uno scrive qui finisce nel
    // messaggio di sistema dell'agente Aiuto di un ALTRO, presentato come
    // percorso già riuscito. Finché il create chiedeva solo dei vincoli di
    // forma, con la chiave web del repo pubblico chiunque depositava un
    // "percorso" per il dominio che voleva, saltando i due LLM che nell'app
    // ripuliscono i percorsi prima di salvarli — e le regole non hanno modo di
    // provare che quei due LLM siano passati: girano sulla macchina di chi
    // naviga.
    //
    // Quindi il client NON scrive più: invia alla callable `pathSubmit` di
    // filo-security, che riapplica la pulizia condivisa
    // (src/shared/pathsSafety.js → sanitizeSubmission), tiene i limiti di
    // frequenza per identità e scrive con l'Admin SDK, che bypassa queste
    // regole. Il mittente resta anonimo: a cambiare è la strada, non il login.
    //
    // La lettura resta aperta a chiunque — serve all'Aiuto di chiunque, anche
    // sloggato — ma UN DOMINIO ALLA VOLTA, e quello che si legge qui è
    // CONTENUTO ESTERNO: chi lo mette in un prompt lo incapsula e lo dichiara
    // dati, mai ordini (src/shared/pathsSafety.js → formatKnownPathsForPrompt,
    // e il blocco "Percorsi condivisi" del prompt Aiuto in
    // src/shared/constants.js).
    //
    // IL DOMINIO È UN SEGMENTO DEL PERCORSO (audit pre-alpha, #584). Prima i
    // documenti stavano tutti in `paths/{doc}` con `allow read: if true`: con
    // la chiave web — che sta nel repo pubblico ed è pubblica per design — una
    // sola query scaricava la collezione INTERA, e in ogni documento c'era un
    // `clientId` in chiaro. Da lì si ricucivano i percorsi della stessa persona
    // su domini diversi: il profilo di navigazione che tutto il resto dell'app
    // si sforza di non far uscire. Chiudere la scrittura (#585) non tocca
    // quella porta: si entrava in lettura.
    //
    // Ora i percorsi stanno in `paths/<dominio>/entries`: si chiede un dominio
    // alla volta e si riceve solo quello. L'elenco completo non è più un
    // oggetto leggibile, e questo poggia su TRE cose insieme — toccarne una
    // sola riapre la porta:
    //   1. `paths/{domain}` (dove stanno anche i vecchi documenti piatti) è
    //      chiuso in lettura: né i documenti di prima, né l'elenco dei domini
    //      raccolti (che da solo direbbe chi frequenta cosa);
    //   2. `entries` si legge solo sotto un dominio NOMINATO;
    //   3. una collection group query su `entries` è negata perché in questo
    //      file non esiste nessun match ricorsivo `/{p=**}/entries/{doc}`:
    //      senza quello il motore rifiuta le query di gruppo. Aggiungerlo
    //      significherebbe rimettere in piedi il download dell'intera raccolta.
    //
    // E il documento non porta NULLA del mittente: niente `clientId`, niente
    // `userAgent` — per riusare un percorso non serve sapere chi l'ha fatto.
    //
    // L'OROLOGIO NON LO CHIUDONO QUESTE REGOLE, e vale la pena saperlo qui.
    // Su ogni documento Firestore scrive da sé `createTime`, al microsecondo, e
    // lo rimanda a chiunque legga: non c'è regola che lo tolga. Finché un
    // percorso partiva nell'istante in cui veniva fatto, due percorsi su domini
    // diversi nati a meno di un secondo l'uno dall'altro erano della stessa
    // persona — la ricucitura che togliere il `clientId` doveva impedire
    // (#584, secondo giro). La difesa sta nel client, in pathsCollector.js: il
    // percorso entra in una coda e parte ore dopo, da solo.
    match /paths/{domain} {
      // Vecchia forma piatta + elenco dei domini: chiusi, per sempre.
      allow read, write: if false;

      match /entries/{doc} {
        // Lettura per dominio. Il tetto sulla `limit` non protegge un segreto
        // (questi dati sono condivisi per progetto): tiene solo la singola
        // richiesta a una manciata di percorsi, quanti ne consuma il prompt.
        allow get: if true;
        allow list: if request.query.limit <= 200;

        // Nessun client scrive (#585): il percorso entra solo dalla callable
        // `pathSubmit`, che usa l'Admin SDK e bypassa queste regole. Qui non
        // c'è nessun controllo di forma perché non servirebbe a niente: una
        // regola non vede mai la scrittura che deve fermare, e quella che vede
        // la ferma sempre.
        allow create, update, delete: if false;
      }
    }

    // ── Collezioni del backend di sicurezza (filo-security, DESIGN §13) ──────
    // Scritte SOLO dal backend server-side via Admin SDK, che BYPASSA queste
    // regole. Per il client sono di sola lettura admin (futuri pannelli di
    // audit dell'owner) e MAI scrivibili: niente accesso utente.
    //
    // - identities/* : stato per account/IP (clean/spam/dangerous), contatori.
    // - attacks/*    : corpus dei tentativi (testo, verdetti, sorgente etichetta).
    // - judge-verdicts/* : log dei giudizi L2 (audit/benchmark).
    // La logica e i prompt dei giudici NON vivono qui (sono nel backend
    // privato): queste collezioni contengono solo stato/dati, non il "cervello".
    match /identities/{doc} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /attacks/{doc} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /judge-verdicts/{doc} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ── Canale red-team (filo-redteam-ux-spec §9, DESIGN §9) ─────────────────
    // SERVER-AUTHORITATIVE: scritto SOLO dal backend via Admin SDK (bypassa
    // queste regole). Il client NON scrive MAI — altrimenti un utente si
    // auto-verificherebbe, falsificherebbe punteggi/ricompense o si auto-
    // attribuirebbe verdetti. Le LETTURE del client passano tutte da Cloud
    // Function (redteamState/redteamAttempt/redteamLeaderboard, Admin SDK), che
    // applicano il gating (proprietario, verificato). Quindi qui la lettura
    // diretta è negata al client (solo admin, per pannelli owner futuri).
    //
    // redteam-users/{uid} : verifica + handle + stato gamification (bestPerJudge,
    //   gridUnlocked, milestones, leaderboardScore) + contatori. Lettura del
    //   PROPRIO doc consentita (abilita un eventuale listener real-time; non
    //   espone dati altrui), oltre all'admin.
    match /redteam-users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow read: if isAdmin();
      allow write: if false;
    }
    // redteam-attempts/{id} : tentativi (testo, descrizione, verdetti, score). I
    //   non verificati NON devono vedere i risultati (spec §7.1): per non
    //   replicare quel gating nelle regole, la lettura diretta è solo admin; il
    //   client usa la callable redteamAttempt (che verifica proprietà + stato).
    match /redteam-attempts/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
    // redteam-codes/{code} : codici monouso. Il codice è l'UNICA prova di
    //   abilitazione: se il client potesse leggerli si verificherebbe da solo →
    //   lettura solo admin, scrittura solo server-side (riscatto/generazione).
    match /redteam-codes/{code} {
      allow read: if isAdmin();
      allow write: if false;
    }
    // redteam-handles/{h} : prenotazione handle (unicità leaderboard). Solo backend.
    match /redteam-handles/{h} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
