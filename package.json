{
  "name": "filo",
  "version": "0.2.196",
  "private": true,
  "description": "Filo — browser AI-native cross-device. Layer di interazione, non solo finestra.",
  "main": "src/main/main.js",
  "scripts": {
    "prestart": "node scripts/prestart.mjs",
    "start": "electron .",
    "predev": "git -c user.email=claude@local -c user.name=claude-local pull --rebase --autostash origin main || git rebase --abort || echo \"[predev] git pull saltato\"",
    "dev": "electron . --enable-logging",
    "test:smoke": "node tests/smoke.mjs",
    "test:unit": "node scripts/run-unit-tests.mjs",
    "transparency": "node scripts/build-transparency.mjs",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:explore": "node tests/agent/explore.mjs",
    "test:daily": "node tests/agent/daily.mjs",
    "test:shoot": "node tests/agent/shoot.mjs",
    "finish": "node scripts/finish-local.mjs",
    "finish:check": "node scripts/finish-local.mjs --check",
    "feedback:backfill": "node scripts/backfill-feedback-numbers.mjs",
    "feedback:auto-archive": "node scripts/auto-archive.mjs",
    "feedback:login": "node scripts/admin-login.mjs",
    "build": "electron-builder --win",
    "release": "electron-builder --win --publish always",
    "feedback": "node scripts/owner-feedback.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "ai.filo.desktop",
    "productName": "Filo",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "Filo-Setup.${ext}",
      "icon": "assets/icons/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "installerIcon": "assets/icons/icon.ico",
      "uninstallerIcon": "assets/icons/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icons/icon-256.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icons/icon-256.png"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "sathyaram1",
        "repo": "Filo"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.3"
  }
}
