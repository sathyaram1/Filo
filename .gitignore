node_modules
dist/
# Chiavi di default incastonate dalla CI nel build (contiene segreti veri):
# non deve mai tornare nel repo pubblico. La scrive scripts/bake-default-config.mjs.
src/main/config/default-keys.generated.json
.feedback-images/
# Screenshot/artefatti dei test: output rigenerato, MAI committare (i PNG
# binari generano conflitti di rebase tra sessioni locali e routine cloud).
tests/.report/
tests/.shots/
tests/.smoke/
# Spec di audit usate dalle routine cloud per RIPRODURRE un ritrovamento prima
# di accodarlo come feedback: sono usa-e-getta (asseriscono che il bug ESISTE,
# quindi diventano rosse appena il bug viene fixato). Non vanno mai committate —
# l'hook auto-commit fa `git add -A`, quindi senza questa regola finivano su main.
tests/_audit*.spec.mjs
tests/.fb/*.png
tests/agent/.env
tests/agent/.out/
tests/agent/reports/
test-results/
.DS_Store
*.log

# worktree annidate (mai committare come gitlink)
.claude/worktrees/
# Identità attesa del ramo (branch-guard.sh): effimera e locale alla macchina,
# la scrive il dispatcher quando consegna il lavoro. Versionarla non avrebbe
# senso — dice "questa directory, adesso".
.claude/branch-expect.json
