node_modules
dist/
# Chiavi di default incastonate dalla CI nel build (contiene segreti veri):
# non deve mai tornare nel repo pubblico. La scrive scripts/bake-default-config.mjs.
src/main/config/default-keys.generated.json
.feedback-images/
# Screenshot/artefatti dei test: output rigenerato, MAI committare (i PNG
# binari generano conflitti di rebase tra sessioni locali e routine cloud).
tests/.report/
tests/.shots/
tests/.smoke/
# Spec di audit usate dalle routine cloud per RIPRODURRE un ritrovamento prima
# di accodarlo come feedback: sono usa-e-getta (asseriscono che il bug ESISTE,
# quindi diventano rosse appena il bug viene fixato). Non vanno mai committate —
# l'hook auto-commit fa `git add -A`, quindi senza questa regola finivano su main.
tests/_audit*.spec.mjs
# Spec temporanee dei verifier/secaudit (prefisso _verify / _vcheck): usa-e-getta
# per verificare un fix su un branch, ricreate fresche a ogni giro. Stessa ragione
# delle _audit sopra: senza questa regola l'`git add -A` dell'hook le committa su
# main, dove si accumulano e diventano flaky nella suite completa.
tests/_verify*.spec.mjs
tests/_vcheck*.spec.mjs
tests/.fb/*.png
tests/agent/.env
tests/agent/.out/
tests/agent/reports/
test-results/
.DS_Store
*.log

# worktree annidate (mai committare come gitlink)
.claude/worktrees/
# Identità attesa del ramo (branch-guard.sh): effimera e locale alla macchina,
# la scrive il dispatcher quando consegna il lavoro. Versionarla non avrebbe
# senso — dice "questa directory, adesso".
.claude/branch-expect.json
# Esito della verifica indipendente del lavoro locale: riguarda questa macchina
# e questo momento (ramo + commit verificato), non ha senso versionarlo.
.claude/verify-local.json
# Ruolo dell'istanza al lavoro (esplorazione/sviluppo/verifica): stessa natura,
# lo scrive il dispatcher e lo rilegge chi accoda un feedback per firmarlo.
.claude/routine-role.json

# Il biglietto del giro in corso. Stessa natura effimera degli altri marcatori,
# ma qui l'ignoranza NON è solo pulizia: è un SEGRETO, e questo repo è pubblico.
# Il salvataggio automatico committa e spedisce a ogni modifica di file: senza
# questa riga, un biglietto vivo finirebbe nella storia pubblica — cioè
# esattamente il difetto che la spec ROUTINE-AUTH-SPEC.md viene a togliere,
# ricreato dal marcatore che serve a toglierlo.
.claude/routine-ticket.json

# Stato locale del giro (ripiego: quello vero vive sul server). Effimero come
# gli altri marcatori — e soprattutto NON deve tornare nel repo, che e' il
# posto da cui questa roba e' appena stata tolta.
.claude/routine-state/
